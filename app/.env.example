# Environment
ENV=development
APP_NAME=API
APP_VERSION=1.0.0

# Server
LOG_LEVEL=INFO

# Database (async SQLAlchemy URL)
# Examples:
# postgres:   postgresql+asyncpg://user:pass@host:5432/dbname
# mysql:      mysql+aiomysql://user:pass@host:3306/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Optional: separate DB for tests (recommended)
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/app_test

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600

# CORS (optional)
CORS_ORIGINS=http://localhost:3000

# Requests logging (optional)
ENABLE_REQUEST_LOGS=true
