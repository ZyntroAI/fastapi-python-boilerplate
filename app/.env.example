# ─── Project ───
PROJECT_NAME=ZyntroAI Hook Engine
VERSION=1.0.0
ENVIRONMENT=development  # development | staging | production
DEBUG=true

# ─── Server ───
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ─── Logging ───
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ─── Future Use ───
 DATABASE_URL=mongodb://localhost:27017/zyntro_hooks
 REDIS_URL=redis://localhost:6379/0
