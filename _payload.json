[{"data":1,"prerenderedAt":739},["ShallowReactive",2],{"/resources/developer-survey":3,"navigation-en-us":67,"footer-en-us":494},{"id":4,"title":5,"body":6,"category":6,"config":7,"content":11,"description":6,"extension":57,"meta":58,"navigation":59,"path":60,"seo":61,"slug":6,"stem":65,"testContent":6,"type":6,"__hash__":66},"pages/en-us/resources/developer-survey.yml","Developer Survey",null,{"template":8,"slug":9,"layout":10},"ResourcePage","developer-survey","no-banner",{"config":12,"form":17,"accordion":22,"formBackgroundImage":29,"tagline":32,"mobileButton":33,"imageGallery":38,"subtitle":55,"title":56},{"showLogo":13,"id":14,"typographyVariants":15},false,"download-form",{"header":16},"heading2-bold",{"config":18,"formHeader":21},{"redirectToAsset":13,"formId":19,"formName":20},"28379","resources","Get the report",[23,26],{"header":24,"content":25},"Report Overview","The 9th annual Global DevSecOps Survey takes a close look at how AI will redefine DevSecOps in 2026 and beyond. How are the roles of DevSecOps professionals changing? What skills should they be honing? What is the current split between human and AI contributions in software development — and what do teams want it to be? See what we learned from surveying 3,266 DevSecOps professionals across the world and various industries.",{"header":27,"content":28},"What you’ll learn","- How AI is reshaping roles and creating the need for more engineers (not fewer).\n\n- The ideal split between human and AI contributions in software development.\n\n- How many hours teams are losing to inefficient processes.\n\n- The AI skills DevSecOps teams need in 2026 — and the challenges in the way.",{"config":30},{"src":31},"https://res.cloudinary.com/about-gitlab-com/image/upload/v1761847618/wmp3lwdivwdw9plgk15u.png","Research Report",{"text":21,"config":34},{"href":35,"dataGaName":36,"dataGaLocation":37},"#form-container","get the report","body",[39,43,47,51],{"config":40,"altText":42},{"src":41},"https://res.cloudinary.com/about-gitlab-com/image/upload/v1761770778/jst4uy3czcwot4bjngrm.jpg","Cover of the 2026 Global DevSecOps Report, The Intelligent Software Development Era.",{"config":44,"altText":46},{"src":45},"https://res.cloudinary.com/about-gitlab-com/image/upload/v1761769055/dmlbdctsv7rgp9poap49.jpg","Chart showing code source share: 34% AI-generated, 37% written from scratch, 29% copied from other sources.",{"config":48,"altText":50},{"src":49},"https://res.cloudinary.com/about-gitlab-com/image/upload/v1761769055/t66x3sdxeg4mei33x3q2.jpg","Slide titled “The AI Efficiency Paradox” about toolchain sprawl slowing collaboration.",{"config":52,"altText":54},{"src":53},"https://res.cloudinary.com/about-gitlab-com/image/upload/v1761769055/gypb5geh8phgla4wrqz7.jpg","Chart on deployment frequency with 83% using AI in the SDLC for multiple daily deployments and a breakdown by cadence.","A global survey of 3,000+ DevSecOps practitioners reveals the skills, tools, and strategies that can make or break a team’s ability to deliver more secure software faster with AI in 2026 and beyond.","The Intelligent Software Development Era.","yml",{},true,"/en-us/resources/developer-survey",{"config":62,"title":63,"description":64},{"noIndex":13},"GitLab Global DevSecOps Report","See what we learned from surveying 3,266 DevSecOps professionals across the world and various industries.","en-us/resources/developer-survey","GOYtl5g1WwaTz9W7hfz2l8gXinFh8rvwCBL2NlAzfm8",{"logo":68,"freeTrial":73,"sales":78,"login":83,"items":88,"search":414,"minimal":445,"duo":464,"switchNav":473,"pricingDeployment":484},{"config":69},{"href":70,"dataGaName":71,"dataGaLocation":72},"/","gitlab logo","header",{"text":74,"config":75},"Get free trial",{"href":76,"dataGaName":77,"dataGaLocation":72},"https://gitlab.com/-/trial_registrations/new?glm_source=about.gitlab.com&glm_content=default-saas-trial/","free trial",{"text":79,"config":80},"Request a demo",{"href":81,"dataGaName":82,"dataGaLocation":72},"/sales/?contact-top