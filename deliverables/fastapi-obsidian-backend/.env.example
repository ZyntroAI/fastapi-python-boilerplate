# FastAPI Obsidian Backend — copy into this directory as .env
# Read by app/config.py and app/security.py.

DATABASE_URL=sqlite:///./obsidian.db

# Where skills and data live. Both default under the package data dir.
DATA_DIR=./data
SKILLS_DIR=./data/skills

# Base URL of the Obsidian REST API (no trailing slash needed)
OBSIDIAN_API_URL=
OBSIDIAN_API_TOKEN=
OBSIDIAN_VERIFY_SSL=true

JWT_TTL_MINUTES=60
