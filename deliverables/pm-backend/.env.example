# Program Management Backend — copy to deliverables/pm-backend/.env
# Loaded by app/config.py, which has a built-in .env reader.

DEBUG=false

# Defaults to a local SQLite file when unset.
DATABASE_URL=sqlite:///./pm_backend.db

# Opt-in encryption at rest. When false the cryptography package is never
# imported and string fields are stored as plain text.
ENCRYPT_AT_REST=false
ENCRYPTION_KEY=
# Used to derive a stable key when ENCRYPTION_KEY is unset.
ENCRYPTION_SECRET=change-me

TOOL_STATE_FILE=./tool_state.json

# ── Billing (provider-neutral) ─────────────────────────────────────────
# Only the selected provider's adapter is needed at runtime.
# stub | paddle (Paddle additionally needs PADDLE_SANDBOX_BASE_URL in tests)
BILLING_PROVIDER=stub
BILLING_API_KEY=
BILLING_BASE_URL=

# ── Tool switcher ──────────────────────────────────────────────────────
# pm_csv | billing | settings
ACTIVE_TOOL=pm_csv
