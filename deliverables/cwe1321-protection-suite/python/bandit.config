[bandit]
# Bandit config for the Python layer of the CWE-1321 protection suite.
# Fail the build on any medium-or-higher finding so CI acts as a real gate.
# Bandit is a generic Python vulnerability scanner; prototype-pollution
# (CWE-1321) patterns are caught by the dedicated Semgrep rule set and the
# runtime guard in safe_parser.py. This config sets the severity baseline
# Bandit enforces on the scanned tree.
aggregate = true
number = 3
output = bandit-report.txt
quiet = false
severity = medium
confidence = medium
recursive = true
