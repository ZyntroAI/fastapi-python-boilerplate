# product-crud web client — copy to deliverables/product-crud/web/.env
# Only VITE_-prefixed values reach the browser bundle.

# Base URL for API calls. Leave empty to use the dev-server proxy below.
VITE_API_BASE_URL=

# Dev-server proxy target for /api (defaults to http://localhost:4000)
VITE_API_PROXY=http://localhost:4000
