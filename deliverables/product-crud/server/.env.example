# product-crud API server — copy to deliverables/product-crud/server/.env
# docker-compose mounts this path, so the credentials here must match the
# POSTGRES_* values in deliverables/product-crud/docker-compose.yml.

# Prisma reads DATABASE_URL directly
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/products

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
