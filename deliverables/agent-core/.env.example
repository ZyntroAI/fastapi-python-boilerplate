# Copy to .env and fill in. .env is gitignored — never commit real values.

# Provider
AGENT_PROVIDER=agent
AGENT_BASE_URL=https://api.agent.ai/v2
AGENT_API_KEY=

# Resilience
AGENT_TIMEOUT=120
AGENT_MAX_RETRIES=3
AGENT_POLL_INTERVAL=2
AGENT_POLL_TIMEOUT=300

# Persistence (optional — only needed to store task history)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
