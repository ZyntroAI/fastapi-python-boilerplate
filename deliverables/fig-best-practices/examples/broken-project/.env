# Service configuration — this file must never be committed.
# The gate flags it by filename, which is the SECURITY criterion's point.
#
# Values are deliberately inert placeholders so that this fixture cannot be
# mistaken for a real leak by any external secret scanner running over the repo.
DATABASE_URL=postgres://example-user@db.example.internal:5432/app
LOG_LEVEL=debug
FEATURE_FLAG_NEW_UI=on
