{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZyntroAI/fastapi-python-boilerplate/deliverables/fig-best-practices/integrations/integration.schema.json",
  "title": "FIG integration contract",
  "description": "Declares how a project integrates with an external provider. Validated by figbp/integrations.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provider", "transport", "auth", "owner"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,48}$",
      "description": "Stable kebab-case identifier."
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "Human name of the provider."
    },
    "transport": {
      "type": "string",
      "enum": ["rest", "graphql", "websocket", "webhook", "mcp", "sdk"]
    },
    "baseUrl": {
      "type": "string",
      "pattern": "^https://",
      "description": "Must be HTTPS — plaintext transport is rejected."
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "secretRef"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["oauth2", "api_key", "bearer", "mtls", "none"]
        },
        "secretRef": {
          "type": "string",
          "pattern": "^env:[A-Z][A-Z0-9_]*$|^vault:[a-z0-9/-]+$|^none$",
          "description": "Reference only. A literal secret here fails validation."
        },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Least privilege: list them explicitly."
        }
      }
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "backoffMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "retryOn": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 }
        }
      }
    },
    "egress": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit hostnames the integration may reach. Empty means none."
    },
    "dataClassification": {
      "type": "string",
      "enum": ["public", "internal", "confidential", "pii"]
    },
    "owner": {
      "type": "string",
      "description": "A role declared in the policy, not a person's name."
    },
    "notes": { "type": "string" }
  }
}
