# Docker stack — environment template
#
# Copy to the repo root as .env before starting the stack:
#   cp deliverables/docker-stack/.env.stack.example .env
#
# The app reads these through app/core/config.py (pydantic-settings) and
# app/config.py. Nothing here is a real secret — replace before deploying.

# ─── Runtime ────────────────────────────────────────────────────────────
ENV=production
API_PORT=8000

# ─── Database ───────────────────────────────────────────────────────────
# app/config.py defaults DATABASE_URL to a local sqlite file. The stack points
# it at the postgres service instead, so both must agree on the password.
DB_PASSWORD=apppass
DATABASE_URL=postgresql+asyncpg://app:apppass@postgres:5432/appdb

# ─── Cache ──────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Auth ───────────────────────────────────────────────────────────────
# Two settings modules read this under different names, so the stack sets
# both: app/core/config.py wants JWT_SECRET, app/config.py wants JWT_SECRET_KEY.
# Replace in any environment that is not your laptop.
JWT_SECRET=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ─── Frontend / CORS ────────────────────────────────────────────────────
# config.CORS_ORIGINS returns [FRONTEND_URL], so this is the allowed origin.
FRONTEND_URL=http://localhost:3000

# ─── Optional proxy profile ─────────────────────────────────────────────
PROXY_PORT=8080

TIMEZONE=Asia/Bangkok
