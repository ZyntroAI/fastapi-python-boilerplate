นี่คือโค้ด Python สำหรับสร้างรูปภาพผ่าน Command Line (CLI) โดยเชื่อมต่อกับ OpenAI API (DALL-E 3) ซึ่งเป็นเทคโนโลยีหลักตัวเดียวกับที่อยู่เบื้องหลัง Microsoft Copilot ครับ
สิ่งที่ต้องเตรียมก่อนเริ่ม

1. ติดตั้งคลังโปรแกรม (Library) ของ OpenAI ใน Terminal:

pip install openai requests

2. ตั้งค่ารหัส API Key ของคุณในระบบ (Environment Variable):
• Windows (CMD): set OPENAI_API_KEY="คีย์ของคุณ" 
◦ Mac / Linux: export OPENAI_API_KEY="คีย์ของคุณ"

───

โค้ด Python (generate_image.py)

import osimport sysimport requestsfrom openai import OpenAI
def generate_and_download_image(prompt, output_filename="output.png"):
# 1. ตรวจสอบและดึง API Key จากระบบ
api_key = os.getenv("OPENAI_API_KEY")
if not api_key:
print("❌ Error: ไม่พบ OPENAI_API_KEY ในระบบของคุณ")
sys.exit(1)

# 2. เริ่มต้นใช้งาน OpenAI Client
client = OpenAI(api_key=api_key)

print(s"🤖 กำลังส่ง Prompt ไปยัง DALL-E 3: '{prompt}'...")

try:
# 3. เรียกใช้งาน API เพื่อสร้างรูปภาพ
response = client.images.generate(
model="dall-e-3",
prompt=prompt,
size="1024x1024",
quality="standard",
n=1,
)

# 4. ดึง URL ของรูปภาพที่สร้างเสร็จแล้ว
image_url = response.data[0].url
print("🔗 สร้างรูปภาพสำเร็จ! กำลังดาวน์โหลด...")

# 5. ดาวน์โหลดไฟล์ภาพมาบันทึกลงเครื่อง locally
img_data = requests.get(image_url).content
with open(output_filename, 'wb') as handler:
handler.write(img_data)

print(s"✅ บันทึกรูปภาพเรียบร้อยแล้วในชื่อไฟล์: {output_filename}")

except Exception as e:
print(s"❌ เกิดข้อผิดพลาด: {e}")
if name == "main":
# ตรวจสอบว่าผู้ใช้ใส่ Prompt มาใน Command Line หรือไม่
if len(sys.argv) < 2:
print("💡 วิธีใช้งาน: python generate_image.py 'คำอธิบายรูปภาพที่คุณต้องการ'")
sys.exit(1)

# รวมข้อความ Prompt จาก arguments ทั้งหมด
user_prompt = " ".join(sys.argv[1:])
generate_and_download_image(user_prompt)

