{
  // ─── CORE: Editor & Files ───
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit",
    "source.organizeImports.ruff": "explicit"
  },
  "editor.rulers": [88, 100],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/.git": true,
    "**/storage/logs": false,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "search.exclude": {
    "**/vendor": true,
    "**/node_modules": true,
    "**/.next": true,
    "**/storage/framework": true
  },

  // ─── PHP / Laravel ───
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.tabSize": 4,
    "editor.formatOnSave": true
  },
  "intelephense.format.enable": true,
  "intelephense.format.braces": "psr12",
  "intelephense.environment.phpVersion": "8.3",
  "php.validate.executablePath": "/usr/bin/php",
  "php.suggest.basic": false,
  "phpcs.standard": "PSR12",

  // ─── Python ───
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.rulers": [88],
    "editor.tabSize": 4
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.autoImportCompletions": true,

  // ─── JS / TS / Next.js ───
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "eslint.run": "onType",
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
  "prettier.tabWidth": 2,
  "prettier.printWidth": 100,
  "prettier.singleQuote": true,
  "typescript.preferences.importModuleSpecifier": "relative",

  // ─── Docker & Dev Containers ───
  "docker.showInActivityBar": true,
  "docker.groupImages": "ImageName",
  "dev.containers.dockerComposePath": "docker-compose.yml",
  "remote.SSH.showLoginTerminal": true,

  // ─── Git & AI Tools ───
  "gitlens.defaultDateFormat": "YYYY-MM-DD",
  "gitlens.blame.compact": true,
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true
  },
  "github.copilot.advanced": {
    "length": 80,
    "temperature": 0.2
  },
  "copilot-labs-semantic.enabled": true,
  "copilot-labs-semantic.indexLanguages": ["python", "typescript", "javascript", "php"],
  "copilot-labs-semantic.autoIndex": true,

  // ─── Terminal ───
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}/src"
  }
}
