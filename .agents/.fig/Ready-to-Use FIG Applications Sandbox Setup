☸️ 2. Ephemeral Kubernetes Sandbox Template
 
 k8s/sandbox-namespace.yaml 
 
yaml
  
apiVersion: v1
kind: Namespace
metadata:
  name: fig-sandbox-{{ rand }}
  labels:
    app: fig-apps
    env: sandbox
    temporary: "true"
  annotations:
    expiry: "24h"       # Auto-delete marker
    owner: "fig-team"
    purpose: "pr-testing"

---
# Resource limits to prevent runaway costs
apiVersion: v1
kind: ResourceQuota
metadata:
  name: sandbox-quota
  namespace: fig-sandbox
spec:
  hard:
    requests.cpu: "2"
    requests.memory: 4Gi
    limits.cpu: "4"
    limits.memory: 8Gi
    pods: "10"
    services: "5"

---
# Policy: no real secrets allowed
apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: sandbox-no-real-secrets
spec:
  rules:
  - name: block-real-tokens
    match:
      resources:
        kinds: [Secret]
    validate:
      message: "Sandbox: use dummy values only"
      pattern:
        data:
          token: "sandbox-*"
          api_key: "fake-*"
 
 
▶️ Deploy:
 
bash
  
# Create unique sandbox
SANDBOX_NS="fig-sandbox-$(date +%Y%m%d-%H%M)"
kubectl create namespace "$SANDBOX_NS"
kubectl apply -f k8s/sandbox-namespace.yaml -n "$SANDBOX_NS"

# Cleanup
kubectl delete namespace "$SANDBOX_NS"
 
 
 
 
💰 3. Mock FinTech API Server — Payments & Assets
 
 mock-sandbox-api/main.py 
 
python
  
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import uuid
from datetime import datetime

app = FastAPI(title="FIG Sandbox Mock API", version="1.0-sandbox")

# === IN-MEMORY ONLY — RESETS ON RESTART ===
fake_users = {
    "usr_sandbox_001": {"balance": 10000.0, "currency": "SBX"},
    "usr_sandbox_002": {"balance": 5000.0, "currency": "SBX"},
}
transactions = []

class TransferRequest(BaseModel):
    from_user: str
    to_user: str
    amount: float

@app.get("/")
def root():
    return {
        "env": "SANDBOX",
        "notice": "FAKE VALUES ONLY — no real funds",
        "timestamp": datetime.utcnow().isoformat()
    }

@app.get("/users/{user_id}")
def get_balance(user_id: str):
    if user_id not in fake_users:
        raise HTTPException(404, "Sandbox user not found")
    return {"user_id": user_id, **fake_users[user_id]}

@app.post("/transfer")
def transfer(tx: TransferRequest):
    if tx.from_user not in fake_users or tx.to_user not in fake_users:
        raise HTTPException(404, "User not in sandbox")
    if fake_users[tx.from_user]["balance"] < tx.amount:
        raise HTTPException(400, "Insufficient sandbox funds")
    
    fake_users[tx.from_user]["balance"] -= tx.amount
    fake_users[tx.to_user]["balance"] += tx.amount
    tx_id = f"sbx-tx-{uuid.uuid4().hex[:8]}"
    transactions.append({
        "id": tx_id, **tx.dict(), "time": datetime.utcnow().isoformat()
    })
    return {"status": "sandbox-success", "tx_id": tx_id}

@app.get("/transactions")
def list_txs():
    return {"count": len(transactions), "transactions": transactions}

@app.post("/reset")
def reset_sandbox():
    """Wipe all data — fresh sandbox state"""
    global fake_users, transactions
    fake_users = {
        "usr_sandbox_001": {"balance": 10000.0, "currency": "SBX"},
        "usr_sandbox_002": {"balance": 5000.0, "currency": "SBX"},
    }
    transactions = []
    return {"reset": "complete", "message": "Sandbox wiped clean"}

if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=8080)
 
 
