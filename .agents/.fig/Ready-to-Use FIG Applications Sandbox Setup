📦 1. Docker / DevContainer Sandbox
 
 docker-compose.sandbox.yml 
 
yaml
  
version: '3.8'

services:
  fig-sandbox:
    build:
      context: .
      dockerfile: .devcontainer/Dockerfile
    image: fig-sandbox:latest
    container_name: fig-sandbox
    volumes:
      - .:/workspace:cached
      - sandbox-home:/root
    working_dir: /workspace
    environment:
      - SANDBOX=true
      - ENV_NAME=sandbox
      - NODE_ENV=development
      - PYTHONPATH=/workspace
    ports:
      - "8080:8080"
      - "9000:9000"
    # Auto-cleanup: remove after stop
    restart: no
    command: sleep infinity

volumes:
  sandbox-home:
 
 
 .devcontainer/Dockerfile 
 
dockerfile
  
FROM python:3.11-slim

WORKDIR /workspace

# Install base tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl gnupg ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (for sandbox-in-docker tests)
RUN curl -fsSL https://get.docker.com -o get-docker.sh && sh get-docker.sh

# Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Non-root user for security
RUN useradd -m sandbox && chown -R sandbox:sandbox /workspace
USER sandbox
 
 
