🤖 4. CI/CD — Pull Request Sandbox Workflow
 
 .github/workflows/sandbox-validate.yml 
 
yaml
  
name: FIG Sandbox Validation
on:
  pull_request:
    types: [opened, synchronize, reopened]

jobs:
  sandbox-test:
    runs-on: ubuntu-latest
    # ⚠️ Never use production secrets here
    environment: sandbox
    steps:
      - uses: actions/checkout@v4

      - name: 🧪 Start Sandbox Env
        run: docker compose -f docker-compose.sandbox.yml up -d --build

      - name: Run Lint
        run: docker compose -f docker-compose.sandbox.yml exec -T fig-sandbox make lint

      - name: Run Unit Tests
        run: docker compose -f docker-compose.sandbox.yml exec -T fig-sandbox make test

      - name: Test Against Mock FinTech API
        run: |
          docker compose -f docker-compose.sandbox.yml exec -T fig-sandbox \
            python -m pytest tests/sandbox/ -v

      - name: 🧹 Complete Cleanup
        if: always()
        run: docker compose -f docker-compose.sandbox.yml down -v
 
 
 
 
