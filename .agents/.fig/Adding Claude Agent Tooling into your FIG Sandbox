🚀 2. Claude Agent Sandbox Runtime
 
 agent/claude_sandbox_agent.py 
 
python
  
import os
import sys
import json
import yaml
from pathlib import Path
from typing import Dict, Any, Optional
import anthropic

SANDBOX_ROOT = Path("/workspace/sandbox")
SANDBOX_ENV = os.getenv("ENVIRONMENT", "sandbox")

class SandboxAgent:
    def __init__(self, config_path: str = "agent/agent_config.yaml"):
        # Load config
        with open(config_path) as f:
            self.config = yaml.safe_load(f)
        
        # Initialize — use SANDBOX key only
        api_key = os.getenv("ANTHROPIC_SANDBOX_KEY")
        if not api_key:
            print("⚠️ No ANTHROPIC_SANDBOX_KEY set — running in dry-run mode")
            self.client = None
        else:
            self.client = anthropic.Anthropic(api_key=api_key)
        
        # Ensure safe directories
        SANDBOX_ROOT.mkdir(exist_ok=True)
        (SANDBOX_ROOT / "work").mkdir(exist_ok=True)
        print(f"✅ Agent initialized in SANDBOX mode | Root: {SANDBOX_ROOT}")

    def _validate_path(self, path: str) -> Path:
        """🔒 Prevent escape from sandbox"""
        p = (SANDBOX_ROOT / path).resolve() if not path.startswith("/") else Path(path).resolve()
        
        if not str(p).startswith(str(SANDBOX_ROOT.resolve())):
            raise PermissionError(f"⛔ Blocked: {path} escapes sandbox boundary")
        return p

    def run_python(self, code: str) -> Dict[str, Any]:
        """Tool: Execute code safely"""
        import io
        import contextlib

        stdout = io.StringIO()
        result = {"status": "success", "stdout": "", "stderr": ""}
        
        try:
            with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stdout):
                exec(code, {"__sandbox__": True, "SANDBOX": True}, {})
            result["stdout"] = stdout.getvalue()
        except Exception as e:
            result.update({"status": "error", "stderr": str(e)})
        
        return result

    def call_mock_api(self, method: str, path: str, body: Optional[dict] = None) -> Dict[str, Any]:
        """Tool: Query FIG mock FinTech API"""
        import requests
        base = self.config["tools"][3]["endpoint"]
        
        try:
            resp = requests.request(
                method=method,
                url=f"{base}{path}",
                json=body,
                timeout=10
            )
            return {"status": resp.status_code, "data": resp.json()}
        except Exception as e:
            return {"status": "error", "message": str(e)}

    def reset_sandbox(self) -> Dict[str, str]:
        """Tool: Full sandbox reset"""
        import shutil
        if SANDBOX_ROOT.exists():
            shutil.rmtree(SANDBOX_ROOT)
        SANDBOX_ROOT.mkdir()
        (SANDBOX_ROOT / "work").mkdir()
        return {"status": "reset", "message": "Sandbox fully wiped"}

    def chat(self, user_prompt: str) -> str:
        """Main interaction loop"""
        if not self.client:
            return "[DRY-RUN] Agent would respond to: " + user_prompt

        system_prompt = f"""
You are FIG-Sandbox-Agent. You operate ONLY in the isolated sandbox at {SANDBOX_ROOT}.

RULES — ALWAYS:
1. All file operations → under {SANDBOX_ROOT} ONLY
2. No real credentials, production endpoints, or external networks
3. Call mock FinTech API at http://mock-api:8080 for all finance operations
4. If unsure → call reset_sandbox() to start fresh
5. Explicitly label outputs: [SANDBOX-ONLY]

Available tools: run_python, read_file, write_file, call_mock_api, reset_sandbox
"""

        message = self.client.messages.create(
            model=self.config["agent"]["model"],
            max_tokens=self.config["agent"]["max_tokens"],
            system=system_prompt,
            messages=[{"role": "user", "content": user_prompt}]
        )
        return message.content[0].text


if __name__ == "__main__":
    agent = SandboxAgent()
    
    if len(sys.argv) > 1:
        prompt = " ".join(sys.argv[1:])
        print("\n🤖 Agent Response:")
        print(agent.chat(prompt))
    else:
        print("\n💬 Interactive Mode — type 'exit' to quit")
        while True:
            try:
                prompt = input("\nYou: ")
                if prompt.lower() in ("exit", "quit"):
                    break
                print("🤖 Agent:", agent.chat(prompt))
            except KeyboardInterrupt:
                break
 
 
 
 
