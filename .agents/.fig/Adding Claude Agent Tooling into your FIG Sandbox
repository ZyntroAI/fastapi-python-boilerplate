🐳 4. Updated Docker Compose
 
 docker-compose.sandbox.yml 
 
yaml
  
version: '3.8'

services:
  fig-sandbox:
    build:
      context: .
      dockerfile: .devcontainer/Dockerfile
    image: fig-sandbox:latest
    container_name: fig-sandbox
    volumes:
      - .:/workspace:cached
      - sandbox-root:/workspace/sandbox
    working_dir: /workspace
    environment:
      - SANDBOX=true
      - ENVIRONMENT=sandbox
      - PYTHONPATH=/workspace
    env_file: .env
    ports:
      - "8080:8080"
    restart: no
    command: sleep infinity

  mock-api:
    build:
      context: .
      dockerfile: .devcontainer/Dockerfile
    working_dir: /workspace
    command: python mock-sandbox-api/main.py
    ports:
      - "9000:8080"
    restart: no

  claude-agent:
    build:
      context: .
      dockerfile: .devcontainer/Dockerfile
    working_dir: /workspace
    volumes:
      - .:/workspace:cached
      - sandbox-root:/workspace/sandbox
    env_file: .env
    environment:
      - ENVIRONMENT=sandbox
    depends_on:
      - mock-api
    entrypoint: ["python", "agent/claude_sandbox_agent.py"]
    # Interactive shell for agent chat
    stdin_open: true
    tty: true

volumes:
  sandbox-root:
 
 
 
 
