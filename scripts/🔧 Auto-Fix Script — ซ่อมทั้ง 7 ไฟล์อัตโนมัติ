📄 config.json — mapping ไฟล์ → cause (optional)

json
{
  "dedent_files": [
    "post-comment.yml",
    "build-report.yml",
    "notify-slack.yml",
    "test-summary.yml"
  ],
  "fragment_files": [
    "post-or-update-comment.yml",
    "telegram-alerts.yml"
  ],
  "chat_files": [
    "deploy.yml"
  ],
  "dedent_expected_indent": {
    "post-comment.yml": 6,
    "build-report.yml": 4,
    "notify-slack.yml": 8,
    "test-summary.yml": 4
  }
}


