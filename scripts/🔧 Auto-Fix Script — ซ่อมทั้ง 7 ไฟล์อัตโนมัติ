🔧 Auto-Fix Script — ซ่อมทั้ง 7 ไฟล์อัตโนมัติ

สคริปต์ Python ตัวเดียวที่ตรวจจับ root cause และซ่อมให้อัตโนมัติ พร้อม backup + dry-run

───

📁 โครงสร้าง

yaml-fixer/
├── fix_yaml.py          ← สคริปต์หลัก
├── config.json          ← กำหนดว่าไฟล์ไหนซ่อมแบบไหน
└── backups/             ← เก็บต้นฉบับ (สร้างอัตโนมัติ)


───

📄 fix_yaml.py

python
#!/usr/bin/env python3
"""
YAML Auto-Fixer — ซ่อมไฟล์ GitHub Actions ที่พังจาก 3 root causes

Usage:
    python fix_yaml.py --dry-run          # ดูว่าจะทำอะไร ไม่แก้จริง
    python fix_yaml.py                    # ซ่อมจริง (backup อัตโนมัติ)
    python fix_yaml.py --file deploy.yml  # ซ่อมเฉพาะไฟล์
    python fix_yaml.py --validate-only    # ตรวจอย่างเดียว
"""
import argparse
import json
import re
import shutil
import sys
from datetime import datetime
from pathlib import Path

# ─────────────────────────────────────────────────────
# Config
# ─────────────────────────────────────────────────────
BACKUP_DIR = Path("backups")
WORKFLOW_DIR = Path(".github/workflows")

# สีสำหรับ output
class C:
    OK = "\033[92m"
    WARN = "\033[93m"
    ERR = "\033[91m"
    INFO = "\033[94m"
    BOLD = "\033[1m"
    RESET = "\033[0m"

def log(msg: str, level: str = "info"):
    icons = {
        "info": f"{C.INFO}ℹ{C.RESET}",
        "ok": f"{C.OK}✅{C.RESET}",
        "warn": f"{C.WARN}⚠️{C.RESET}",
        "err": f"{C.ERR}❌{C.RESET}",
    }
    print(f"{icons.get(level, '')} {msg}")

# ─────────────────────────────────────────────────────
# Detection — ตรวจจับ root cause
# ─────────────────────────────────────────────────────
def detect_root_cause(path: Path) -> str:
    """คืนค่า: 'dedent' | 'fragment' | 'chat' | 'ok' | 'unknown'"""
    text = path.read_text(encoding="utf-8")

    # ── Check #3: chat text (ขึ้นต้นด้วยข้อความ + มี ```yaml fence)
    if not text.lstrip().startswith(("name:", "on:", "#", "---")):
        if "```yaml" in text or "```yml" in text:
            return "chat"
        if text.lstrip().startswith("- name:"):
            return "fragment"
        # ข้อความแชทไทย
        if re.search(r"[ก-๙]", text[:200]):
            return "chat"

    # ── Check #2: fragment (ขึ้นต้นด้วย "- name:")
    if text.lstrip().startswith("- name:"):
        return "fragment"

    # ── Check #1: dedent ใน block scalar
    if has_dedent_issue(text):
        return "dedent"

    return "ok"

def has_dedent_issue(text: str) -> bool:
    """ตรวจว่ามีบรรทัดหลุด indent ใน block scalar ไหม"""
    lines = text.splitlines()
    in_block = False
    block_indent = 0

    for i, line in enumerate(lines):
        if not line.strip():
            continue

        # ตรวจ start ของ block scalar
        m = re.match(r"^(\s*)(run|script|with)?:?\s*\|", line)
        if m and ("|" in line):
            in_block = True
            block_indent = len(m.group(1)) + 2  # indent ของ content
            continue

        if in_block:
            indent = len(line) - len(line.lstrip())

            # ถ้าเจอบรรทัดที่ indent น้อยกว่า block แต่ไม่ใช่ 0
            # → น่าจะเป็น dedent
            if 0 < indent < block_indent:
                in_block = False
                continue

            # ถ้าเจอบรรทัดที่ indent = 0 แต่ context ยังเป็น block
            # (บรรทัดก่อนหน้า indent ≥ block_indent)
            if indent == 0 and i > 0:
                prev = lines[i - 1]
                prev_indent = len(prev) - len(prev.lstrip()) if prev.strip() else 0
                if prev_indent >= block_indent and prev.strip():
                    return True

    return False

# ─────────────────────────────────────────────────────
# Fix #1: Dedent ใน Block Scalar
# ─────────────────────────────────────────────────────
def fix_dedent(text: str, is_js_template: bool = False) -> tuple[str, int]:
    """
    ดันบรรทัดที่หลุด indent กลับเข้าไป
    คืน (fixed_text, num_lines_fixed)
    """
    lines = text.splitlines()
    fixed = []
    in_block = False
    block_indent = 0
    fix_count = 0

    for i, line in enumerate(lines):
        m = re.match(r"^(\s*)(.*?):\s*\|\s*$`", line)
        if m:
            in_block = True
            block_indent = len(m.group(1)) + 2
            fixed.append(line)
            continue

        if in_block:
            if not line.strip():
                fixed.append(line)
                continue

            indent = len(line) - len(line.lstrip())

            # บรรทัดหลุด indent → ดันกลับ
            if indent == 0 and i > 0 and fixed[-1].strip():
                prev_indent = len(fixed[-1]) - len(fixed[-1].lstrip())
                if prev_indent >= block_indent:
                    # ดันกลับให้เท่า block
                    new_line = (" " * block_indent) + line
                    fixed.append(new_line)
                    fix_count += 1
                    continue

            # จบบล็อก
            if indent < block_indent and indent > 0:
                in_block = False
                fixed.append(line)
                continue

            fixed.append(line)
        else:
            fixed.append(line)

    result = "\n".join(fixed)
    if text.endswith("\n"):
        result += "\n"

    # เพิ่ม .replace() ให้ JS template literal
    if is_js_template and fix_count > 0:
        result = add_replace_to_templates(result, block_indent)

    return result, fix_count

def add_replace_to_templates(text: str, indent: int)


