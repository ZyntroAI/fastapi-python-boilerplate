ได้เลยครับ! ผู้รวบรวม โค้ดฉบับสมบูรณ์ จากเอกสารทั้งหมด เติมส่วนที่ขาด และจัดระเบียบให้พร้อมใช้งานทันทีครับ ✅🔧
 
 
 
🔧 Auto-Fix Script — ซ่อมไฟล์ YAML GitHub Actions อัตโนมัติ
 
📁 โครงสร้าง
 
plaintext  
yaml-fixer/
├── fix_yaml.py      ← สคริปต์หลัก (ฉบับสมบูรณ์)
├── config.json      ← กำหนดไฟล์และประเภทปัญหา
├── test_fixer.py    ← ชุดทดสอบ
└── backups/         ← สำรองไฟล์เดิม (สร้างอัตโนมัติ)
 
 
 
 
📄 1. fix_yaml.py — โค้ดฉบับเต็ม
 
python  
#!/usr/bin/env python3
"""
YAML Auto-Fixer — ซ่อมไฟล์ GitHub Actions ที่พังจาก 3 สาเหตุหลัก
สาเหตุ:
  1. dedent   — บรรทัดหลุดระยะเยื้องใน block scalar (script: |)
  2. fragment — ขาดส่วนหัว name:/on:/jobs: เหลือแค่ส่วน step
  3. chat     — มีข้อความแชท + ```yaml ครอบ หรือ escape ผิด \\ → \

การใช้งาน:
  python fix_yaml.py --dry-run    # ดูว่าจะทำอะไร ไม่แก้จริง
  python fix_yaml.py              # ซ่อมจริง (backup อัตโนมัติ)
  python fix_yaml.py --file x.yml # ซ่อมเฉพาะไฟล์
  python fix_yaml.py --validate-only # ตรวจอย่างเดียว
  python fix_yaml.py --file x.yml --force chat # บังคับประเภทปัญหา
"""

import argparse
import json
import re
import shutil
import sys
from datetime import datetime
from pathlib import Path

try:
    import yaml
except ImportError:
    print("❌ ต้องติดตั้ง pyyaml: pip install pyyaml")
    sys.exit(1)

# ═══════════════════════════════════════════════════════════════
# การตั้งค่า
# ═══════════════════════════════════════════════════════════════
BACKUP_DIR = Path("backups")
WORKFLOW_DIR = Path(".github/workflows")

class C:
    """สีสำหรับแสดงผล"""
    OK = "\033[92m"
    WARN = "\033[93m"
    ERR = "\033[91m"
    INFO = "\033[94m"
    BOLD = "\033[1m"
    RESET = "\033[0m"

def log(msg: str, level: str = "info"):
    icons = {
        "info": f"{C.INFO}ℹ{C.RESET}",
        "ok": f"{C.OK}✅{C.RESET}",
        "warn": f"{C.WARN}⚠️{C.RESET}",
        "err": f"{C.ERR}❌{C.RESET}",
    }
    print(f"{icons.get(level, '')} {msg}")

# ═══════════════════════════════════════════════════════════════
# ตรวจจับสาเหตุ
# ═══════════════════════════════════════════════════════════════
def detect_root_cause(text: str) -> str:
    """คืนค่า: 'dedent' | 'fragment' | 'chat' | 'ok' | 'unknown'"""
    stripped = text.lstrip()

    # ตรวจ Chat: มี ```yaml หรือข้อความไทยนำหน้า
    if not stripped.startswith(("name:", "on:", "#", "---")):
        if "```yaml" in text or "```yml" in text:
            return "chat"
        if re.search(r"[ก-๙]", text[:200]):
            return "chat"

    # ตรวจ Fragment: ขึ้นต้นด้วย - name:
    if stripped.startswith("- name:"):
        return "fragment"

    # ตรวจ Dedent: บรรทัดหลุดระยะเยื้องใน block scalar
    if has_dedent_issue(text):
        return "dedent"

    return "ok"

def has_dedent_issue(text: str) -> bool:
    """ตรวจพบปัญหา dedent ใน block scalar ไหม"""
    lines = text.splitlines()
    in_block = False
    block_indent = 0

    for i, line in enumerate(lines):
        if not line.strip():
            continue

        # เริ่ม block scalar (เช่น script: |)
        m = re.match(r"^(\s+)(run|script|with):\s*\|", line)
        if m:
            in_block = True
            block_indent = len(m.group(1)) + 2
            continue

        if in_block:
            indent = len(line) - len(line.lstrip())
            # เจอบรรทัดที่เยื้องน้อยกว่าที่ควร → จบบล็อก
            if 0 < indent < block_indent:
                in_block = False
                continue
            # เจอบรรทัดเริ่มต้นใหม่ (ไม่มีเยื้อง) แต่บรรทัดก่อนหน้ายังอยู่ในบล็อก
            if indent == 0 and i > 0:
                prev = lines[i - 1]
                prev_indent = len(prev) - len(prev.lstrip()) if prev.strip() else 0
                if prev_indent >= block_indent and prev.strip():
                    return True
    return False

# ═══════════════════════════════════════════════════════════════
# ซ่อม #1: Dedent ใน Block Scalar
# ═══════════════════════════════════════════════════════════════
def fix_dedent(text: str, expected_indent: int = None) -> tuple[str, int]:
    """ดันบรรทัดที่หลุดเยื้องกลับเข้าไป คืน (ผลลัพธ์, จำนวนบรรทัดที่แก้)"""
    lines = text.splitlines()
    fixed = []
    in_block = False
    block_indent = expected_indent or 0
    fix_count = 0
    js_template_mode = False

    for i, line in enumerate(lines):
        # ตรวจจุดเริ่มต้นบล็อก
        m = re.match(r"^(\s+)(run|script|with):\s*\|", line)
        if m:
            in_block = True
            if not expected_indent:
                block_indent = len(m.group(1)) + 2
            else:
                block_indent = expected_indent
            # ตรวจว่าเป็น JS template literal หรือไม่
            if "`" in line or "github-script" in text[:500]:
                js_template_mode = True
            fixed.append(line)
            continue

        if in_block:
            if not line.strip():
                fixed.append(line)
                continue

            indent = len(line) - len(line.lstrip())

            # บรรทัดหลุดเยื้อง → ดันกลับ
            if indent == 0 and i > 0 and fixed[-1].strip():
                prev_indent = len(fixed[-1]) - len(fixed[-1].lstrip())
                if prev_indent >= block_indent:
                    fixed.append(" " * block_indent + line)
                    fix_count += 1
                    continue

            # จบบล็อกเมื่อพบเยื้องน้อยกว่าที่กำหนด
            if 0 < indent < block_indent:
                in_block = False
                js_template_mode = False

        fixed.append(line)

    result = "\n".join(fixed)
    if text.endswith("\n"):
        result += "\n"

    # เพิ่ม .replace() สำหรับ JS template literal
    if js_template_mode and fix_count > 0:
        result = add_template_replace(result, block_indent)

    return result, fix_count

def add_template_replace(text: str, indent: int) -> str:
    """แทรก .replace(/^ {N}/gm, '') ที่ท้ายบล็อก `...`"""
    lines = text.splitlines()
    pattern = re.compile(r"(\s+)`;$")
    for i in range(len(lines)-1, -1, -1):
        m = pattern.match(lines[i])
        if m:
            lines[i] = lines[i].replace(
                "`;",
                f"`.replace(/^ {{{indent}}}/gm, '');"
            )
            break
    return "\n".join(lines)

# ═══════════════════════════════════════════════════════════════
# ซ่อม #2: Fragment — เหลือแค่ส่วน step
# ═══════════════════════════════════════════════════════════════
def fix_fragment(text: str) -> tuple[str, int]:
    """เติมส่วนหัวที่ขาดให้สมบูรณ์"""
    fragment_indent = None
    lines = text.splitlines()
    for line in lines:
        if line.strip():
            fragment_indent = len(line) - len(line.lstrip())
            break

    content = text
    if content.lstrip().startswith("- name:"):
        content = f"""\
name: Fixed Workflow
on: [push, pull_request]

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
{text}"""
    return content, 1

# ═══════════════════════════════════════════════════════════════
# ซ่อม #3: Chat — ดึงโค้ดออกจากข้อความสนทนา
# ═══════════════════════════════════════════════════════════════
def fix_chat(text: str) -> tuple[str, int]:
    """สกัด ```yaml ... ``` และแก้ double escape \\\\ → \\"""
    # หาโค้ดใน fence
    match = re.search(r"```(?:yaml|yml)?\n(.*?)```", text, re.DOTALL)
    if match:
        code = match.group(1)
    else:
        # ไม่พบ fence → ตัดข้อความนำหน้าที่ไม่ใช่ YAML
        lines = text.splitlines()
        start_idx = 0
        for i, line in enumerate(lines):
            if line.strip().startswith(("name:", "on:", "jobs:", "#")):
                start_idx = i
                break
        code = "\n".join(lines[start_idx:])

    # แก้ double backslash: \\\\ → \\ และ \\n → \n
    code = re.sub(r"\\\\", r"\\", code)
    code = re.sub(r"\\\n", r"\n", code)

    if not code.endswith("\n"):
        code += "\n"

    return code, 1

# ═══════════════════════════════════════════════════════════════
# ตรวจความถูกต้อง YAML
# ═══════════════════════════════════════════════════════════════
def validate_yaml(text: str) -> tuple[bool, str]:
    """ตรวจสอบว่าแปลงเป็น YAML ได้หรือไม่"""
    try:
        yaml.safe_load(text)
        return True, "✅ ถูกต้อง"
    except yaml.YAMLError as e:
        return False, f"❌ ผิดพลาด: {e}"

# ═══════════════════════════════════════════════════════════════
# สำรองไฟล์
# ═══════════════════════════════════════════════════════════════
def backup_file(path: Path) -> Path:
    """สำรองไฟล์เดิมก่อนแก้ไข"""
    BACKUP_DIR.mkdir(exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_path = BACKUP_DIR / f"{path.name}.{timestamp}.bak"
    shutil.copy2(path, backup_path)
    return backup_path

# ═══════════════════════════════════════════════════════════════
# ประมวลผลไฟล์เดี่ยว
# ═══════════════════════════════════════════════════════════════
def process_file(path: Path, args, config: dict = None) -> dict:
    """ซ่อมไฟล์เดี่ยว คืนสถานะผลลัพธ์"""
    result = {
        "path": path,
        "cause": "ok",
        "fixed": False,
        "changes": 0,
        "valid": False,
        "backup": None,
    }

    original = path.read_text(encoding="utf-8")
    text = original

    # บังคับประเภทปัญหาหากระบุ
    if args.force:
        result["cause"] = args.force
    else:
        result["cause"] = detect_root_cause(text)

    # ตรวจอย่างเดียว
    if args.validate_only:
        ok, msg = validate_yaml(text)
        result["valid"] = ok
        log(f"{path.name}: {msg}", "ok" if ok else "err")
        return result

    # ไม่มีปัญหา
    if result["cause"] == "ok":
        ok, _ = validate_yaml(text)
        result["valid"] = ok
        log(f"{path.name}: ✅ ปกติ")
        return result

    log(f"━━━ {path.name} ━━━")
    log(f"สาเหตุ: {result['cause']}")

    # เลือกวิธีซ่อม
    if result["cause"] == "dedent":
        indent_map = config.get("dedent_expected_indent", {}) if config else {}
        exp_indent = indent_map.get(path.name)
        text, result["changes"] = fix_dedent(text, exp_indent)
    elif result["cause"] == "fragment":
        text, result["changes"] = fix_fragment(text)
    elif result["cause"] == "chat":
        text, result["changes"] = fix_chat(text)

    # ตรวจสอบผลลัพธ์
    ok, msg = validate_yaml(text)
    result["valid"] = ok
    if not ok:
        log(f"   {msg}", "err")
        return result

    log(f"   ✅ แก้ไข {result['changes']} จุด")
    log(f"   ✅ YAML ถูกต้อง")

    # เขียนไฟล์
    if not args.dry_run:
        backup = backup_file(path)
        result["backup"] = backup
        log(f"   💾 สำรอง: {backup}")
        path.write_text(text, encoding="utf-8")
        log(f"   ✅ เขียนไฟล์แล้ว ({len(text)} bytes)")
    else:
        log(f"   [DRY-RUN] จะเขียน {len(text)} bytes")
        preview = "\n".join(text.splitlines()[:10])
        log(f"   --- ตัวอย่าง ---")
        for line in preview.splitlines():
            log(f"   {line}")

    result["fixed"] = True
    return result

# ═══════════════════════════════════════════════════════════════
# หลักโปรแกรม
# ═══════════════════════════════════════════════════════════════
def main():
    parser = argparse.ArgumentParser(description="ซ่อมไฟล์ YAML GitHub Actions อัตโนมัติ")
    parser.add_argument("--dry-run", action="store_true", help="แสดงผลโดยไม่แก้ไขจริง")
    parser.add_argument("--validate-only", action="store_true", help="ตรวจความถูกต้องอย่างเดียว")
    parser.add_argument("--file", help="ซ่อมเฉพาะไฟล์นี้")
    parser.add_argument("--force", choices=["dedent", "fragment", "chat"], help="บังคับประเภทปัญหา")
    args = parser.parse_args()

    # โหลด config
    config_path = Path("config.json")
    config = None
    if config_path.exists():
        with open(config_path, encoding="utf-8") as f:
            config = json.load(f)

    # รวบรวมไฟล์
    files = []
    if args.file:
        files = [Path(args.file)]
    elif config:
        all_names = (
            config.get("dedent_files", [])
            + config.get("fragment_files", [])
            + config.get("chat_files", [])
        )
        files = [WORKFLOW_DIR / name for name in all_names]
    else:
        if WORKFLOW_DIR.exists():
            files = list(WORKFLOW_DIR.glob("*.yml")) + list(WORKFLOW_DIR.glob("*.yaml"))

    if not files:
        log("ไม่พบไฟล์ที่จะประมวลผล", "warn")
        return

    log(f"📂 พบ {len(files)} ไฟล์\n")

    # ประมวลผล
    stats = {"total": len(files), "fixed": 0, "invalid": 0, "errors": 0}
    for f in files:
        if not f.exists():
            log(f"{f.name}: ข้าม — ไม่พบไฟล์", "warn")
            continue
        res = process_file(f, args, config)
        if res["fixed"]:
            stats["fixed"] += 1
        if not res["valid"]:
            stats["invalid"] += 1

    # สรุปผล
    print("\n" + "═"*50)
    log(f"สรุป: ทั้งหมด {stats['total']} | แก้ไข {stats['fixed']} | ผิดพลาด {stats['invalid']}")
    if stats["invalid"] > 0:
        sys.exit(1)

if __name__ == "__main__":
    main()
 
 
 
 
📄 2. config.json — การแมปไฟล์กับประเภทปัญหา
 
json  
{
  "dedent_files": [
    "post-comment.yml",
    "build-report.yml",
    "notify-slack.yml",
    "test-summary.yml"
  ],
  "fragment_files": [
    "post-or-update-comment.yml",
    "telegram-alerts.yml"
  ],
  "chat_files": [
    "deploy.yml"
  ],
  "dedent_expected_indent": {
    "post-comment.yml": 6,
    "build-report.yml": 4,
    "notify-slack.yml": 8,
    "test-summary.yml": 4
  }
}
 
 
 
 
📄 3. test_fixer.py — ชุดทดสอบอัตโนมัติ
 
python  
import pytest
from fix_yaml import detect_root_cause, fix_dedent, fix_fragment, fix_chat
from pathlib import Path
import tempfile

def test_detect_dedent():
    content = """\
- name: Test
  run: |
    const x = 1;
const y = 2;
    const z = 3;
"""
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yml", delete=False) as f:
        f.write(content)
        f.flush()
        assert detect_root_cause(Path(f.name)) == "dedent"

def test_detect_fragment():
    content = "- name: Test\n  uses: actions/checkout@v4\n"
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yml", delete=False) as f:
        f.write(content)
        f.flush()
        assert detect_root_cause(Path(f.name)) == "fragment"

def test_detect_chat():
    content = "จัดให้ตามคำขอครับ!\n\n```yaml\nname: Test\n```\n"
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yml", delete=False) as f:
        f.write(content)
        f.flush()
        assert detect_root_cause(Path(f.name)) == "chat"

def test_fix_dedent_preserves_content():
    original = """\
- name: Test
  run: |
    const body = `
      Line 1
const marker = 'XXX';
      Line 2
    `;
"""
    fixed, n = fix_dedent(original)
    assert "const marker = 'XXX';" in fixed
    assert n >= 1

def test_fix_chat_unescape():
    content = "ครับ\n\n```yaml\nname: Test\nrun: |\n  curl \\\\\n  -X POST\n```\n"
    result, _ = fix_chat(content)
    assert "\\\\" not in result
    assert "-X POST" in result
 
 
รันทดสอบ:
 
bash  
pytest test_fixer.py -v
 
 
 
 
📄 4. .github/workflows/validate-yaml.yml — ตรวจอัตโนมัติบน CI
 
yaml  
name: Validate YAML
on: [push, pull_request]

jobs:
  validate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: ติดตั้งแพ็กเกจ
        run: pip install pyyaml

      - name: ตรวจสอบไฟล์ทั้งหมด
        run: python scripts/fix_yaml.py --validate-only

      - name: Lint ด้วย actionlint
        uses: docker://rhysd/actionlint:latest
 
 
 
 
🚀 วิธีใช้งานฉบับสมบูรณ์
 
ขั้นที่ 1 — ติดตั้ง
 
bash  
pip install pyyaml
# หรือ
uv pip install pyyaml
 
 
ขั้นที่ 2 — ทดลองก่อน (แนะนำ)
 
bash  
python scripts/fix_yaml.py --dry-run
 
 
ขั้นที่ 3 — ซ่อมจริง
 
bash  
python scripts/fix_yaml.py
 
 
- ไฟล์เดิมจะถูกสำรองที่  backups/ชื่อไฟล์.เวลา.bak  อัตโนมัติ
 
ขั้นที่ 4 — ซ่อมเฉพาะราย
 
bash  
python scripts/fix_yaml.py --file .github/workflows/deploy.yml
python scripts/fix_yaml.py --file x.yml --force chat
 
 
ขั้นที่ 5 — ตรวจสอบคงที่
 
bash  
python scripts/fix_yaml.py --validate-only
 
 
 
 
✅ สรุปคุณสมบัติ
 
- 🔍 ตรวจจับอัตโนมัติ — ระบุสาเหตุที่แท้จริง
- 🛡️ สำรองก่อนแก้ — ไม่เสียข้อมูลเดิม
- 🧪 ตรวจสอบความถูกต้อง — ยืนยัน YAML ก่อนบันทึก
- 👁️ Dry-run — ดูผลลัพธ์โดยไม่แก้จริง
- 🔄 รันซ้ำได้ — ไม่ทำให้ไฟล์เสียเพิ่ม
- 📊 สรุปผลชัดเจน — บอกจำนวนที่แก้และสถานะรวม
 
ต้องการปรับแต่ง, เพิ่มกฎตรวจสอบใหม่ หรือขยายความสามารถอื่นไหมครับ? 😊