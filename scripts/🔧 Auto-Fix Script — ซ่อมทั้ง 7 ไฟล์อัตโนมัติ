🧪 Test Suite

📄 test_fixer.py

python
import pytest
from fix_yaml import detect_root_cause, fix_dedent, fix_fragment, fix_chat
from pathlib import Path
import tempfile

def test_detect_dedent():
    content = """\
- name: Test
  run: |
    const x = 1;
const y = 2;
    const z = 3;
"""
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yml", delete=False) as f:
        f.write(content)
        f.flush()
        assert detect_root_cause(Path(f.name)) == "dedent"

def test_detect_fragment():
    content = "- name: Test\n  uses: actions/checkout@v4\n"
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yml", delete=False) as f:
        f.write(content)
        f.flush()
        assert detect_root_cause(Path(f.name)) == "fragment"

def test_detect_chat():
    content = "จัดให้ตามคำขอครับ!\n\n```yaml\nname: Test\n```\n"
    with tempfile.NamedTemporaryFile(mode="w", suffix=".yml", delete=False) as f:
        f.write(content)
        f.flush()
        assert detect_root_cause(Path(f.name)) == "chat"

def test_fix_dedent_preserves_output():
    """พิสูจน์ว่าหลัง .replace() ได้ข้อความเดิม"""
    original = """\
- name: Test
  run: |
    const body = `
      Line 1
const marker = 'XXX';
      Line 2
    `;
"""
    fixed, n = fix_dedent(original, is_js_template=True)
    assert "const marker = 'XXX';" in fixed
    assert ".replace(/^" in fixed
    assert n == 1

def test_fix_chat_unescape():
    content = "ครับ\n\n```yaml\nname: Test\nrun: |\n  curl \\\\\n    -X POST\n```\n"
    result = fix_chat(content)
    assert "\\\\" not in result
    assert "\\" in result


รัน:

bash
pytest test_fixer.py -v


