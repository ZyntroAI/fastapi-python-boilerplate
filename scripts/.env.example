# Operational scripts — copy to scripts/.env
#
# scripts/whatsapp_notify.py  → WhatsApp Cloud API alerts
# scripts/push_index.py       → Algolia index
# scripts/kube-cost-check.py  → cluster cost / trace naming
#
# These values are REQUIRED by the scripts (a WhatsApp script will refuse to
# start without the token and phone id).

# ── WhatsApp Cloud API ─────────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Recipient in international format, digits only (no leading +)
ADMIN_PHONE=
WHATSAPP_API_VER=v18.0

# ── Algolia ────────────────────────────────────────────────────────────
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX_NAME=

# ── Misc ───────────────────────────────────────────────────────────────
ORBIT_TRACE_ID=
