# GraphQL API — copy to graphql_api/.env
# Read by graphql_api/app/config.py (pydantic-settings) and docker-compose.

APP_NAME=GraphQL API
DEBUG=false

# Dev default is SQLite; docker-compose injects the Postgres DSN below.
DATABASE_URL=sqlite+aiosqlite:///./graphql.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/graphql_db

REDIS_URL=redis://localhost:6379/0
REDIS_SUB_CHANNEL=graphql:events

# MUST be overridden in production — the default is dev-only.
SECRET_KEY=dev-only-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# docker-compose substitution for the db service
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=graphql_db
