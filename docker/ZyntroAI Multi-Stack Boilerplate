5.3 บริการ & เชื่อมต่อ Python
 
csharp
  
// dotnet/ZyntroAI.Service/Service.cs
namespace ZyntroAI.Service;

public interface IZyntroService
{
    Task<List<Item>> GetItemsAsync(CancellationToken ct);
    Task<StatusDto> GetCoreStatusAsync();
}

public class ZyntroService : IZyntroService
{
    private readonly HttpClient _http;
    public ZyntroService(HttpClient http) => _http = http;

    public async Task<StatusDto> GetCoreStatusAsync()
    {
        return await _http.GetFromJsonAsync<StatusDto>("/api/v1");
    }
}

public record StatusDto(string Status, string Stack, string Version);
 
 
 
 
