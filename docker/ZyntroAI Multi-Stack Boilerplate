// frontend/components/Dashboard.tsx
import { useEffect, useState } from 'react';

type Status = { status: string; version: string; stack: string };

export default function Dashboard() {
  const [data, setData] = useState<Status | null>(null);

  useEffect(() => {
    fetch('/api/v1')
      .then(r => r.json())
      .then(setData);
  }, []);

  return (
    <div className="p-6 bg-gray-50 min-h-screen">
      <h1 className="text-xl font-bold">ZyntroAI Panel</h1>
      <div className="mt-4 p-4 bg-white rounded shadow">
        <p>สถานะ: {data?.status === 'ok' ? '✅ ปกติ' : '❌ ผิดพลาด'}</p>
        <p>เวอร์ชัน: {data?.version}</p>
        <p>แกนกลาง: {data?.stack}</p>
      </div>
    </div>
  );
}
 
 
