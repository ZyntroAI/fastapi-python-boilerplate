6.3 ความปลอดภัย & คอนฟิก
 
php
  
// php/src/Core/Config.php
class Config {
    public function __construct(string $envPath) {
        $this->loadEnv($envPath);
        $this->validateSecure();
    }
    private function validateSecure(): void {
        if (!isset($this->data['APP_KEY']) || strlen($this->data['APP_KEY']) < 32) {
            throw new RuntimeException("APP_KEY ไม่ปลอดภัย");
        }
    }
}
 
 
 
 
