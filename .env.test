# ==================================================
# FIG V4 + CostGuard — TEST ENVIRONMENT
# ไฟล์นี้สำหรับการทดสอบเท่านั้น — ไม่ใช้ในสภาพจริง
# ==================================================

# ====== ระบบ ======
APP_ENV=test
APP_NAME=FIG-V4-TEST
DEBUG=true
LOG_LEVEL=DEBUG

# ====== API (ใช้ Mock/Endpoint ทดสอบ) ======
FIG_API_URL=https://api-test.fig.com/v1
FIG_API_KEY=test_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FIG_TEAM_ID=team_test_00000000-0000-0000-0000-000000000000

# ====== เกณฑ์การแจ้งเตือนเครดิต ======
ALERT_THRESHOLD=2000
MIN_SAFETY_BUFFER=5000
BURN_RATE_DAILY_LIMIT=150
AUTO_DOWNGRADE_ENABLED=true

# ====== ตัวเลือก CostGuard ======
CACHE_TTL_SEC=3600
CACHE_MAX_ENTRIES=1000
CONTEXT_MAX_RECENT_MSGS=3
COST_ESTIMATION_MODE=mock

# ====== อัตราคำนวณต้นทุน (USD ต่อ 1,000 โทเคน) ======
COST_HAIKU_PER_1K=0.00025
COST_SONNET_PER_1K=0.003
COST_OPUS_PER_1K=0.015

# ====== Slack/การแจ้งเตือน (Endpoint ทดสอบ) ======
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/TEST/WEBHOOK/DO_NOT_USE_REAL_HERE
ALERT_CHANNEL=#test-alerts
NOTIFY_ON_FAILURE=true

# ====== ฐานข้อมูล/แคช (หน่วยความจำสำหรับทดสอบ) ======
DATABASE_URL=sqlite:///:memory:
REDIS_URL=memory://localhost:6379/0

# ====== ความปลอดภัย ======
ENCRYPTION_KEY=test_encryption_key_change_in_production_32b
ALLOWED_HOSTS=localhost,127.0.0.1
TEST_MODE=true
