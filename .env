# =====================================================
# 🐳 Docker Registry Credentials
# =====================================================
DOCKERUSERNAME=yourusernamehere
DOCKERPASSWORD=yourtokenhere

# =====================================================
# 🗄️ Database — PostgreSQL
# =====================================================
# รูปแบบ: postgresql://<user>:<pass>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://devops:DevOpsPass2026@postgres:5432/devai_platform

# รหัสผ่านตรงกับ DATABASE_URL ด้านบน
DB_PASSWORD=DevOpsPass2026

# =====================================================
# 📦 MinIO Storage (S3-Compatible)
# =====================================================
MINIO_PASSWORD=MinioPass2026

# =====================================================
# 📈 Grafana Monitoring
# =====================================================
GRAFANA_PASSWORD=Admin123!

✅ วิธีใช้งาน
bash
# 1. ก๊อปปี้ข้างบนไปวางเป็นไฟล์ .env
nano .env   # หรือใช้ Text Editor ตัวถนัด

# 2. แก้ DOCKERUSERNAME / DOCKERPASSWORD ให้ตรงกับบัญชีจริง
# DOCKERUSERNAME=ชื่อบัญชี Docker ของคุณ
# DOCKERPASSWORD=Docker Access Token

# 3. ตรวจสอบว่าโหลดตัวแปรถูกต้อง
docker compose config

# 4. เริ่มบริการ
docker compose up -d

📋 ความสัมพันธ์ของค่า
Table
ตัวแปร	ค่าในตัวอย่าง	หมายเหตุ
DATABASE_URL	postgresql://devops:DevOpsPass2026@postgres:5432/devai_platform	ตรงกับ postgres service ใน compose
DB_PASSWORD	DevOpsPass2026	ต้องตรงกับรหัสใน DATABASE_URL
MINIO_PASSWORD	MinioPass2026	ความยาว ≥ 8 ตัวอักษร
GRAFANA_PASSWORD	Admin123!	รหัสผ่านเข้า Grafana
⚠️ อย่าลืมเปลี่ยน DOCKERUSERNAME และ DOCKERPASSWORD เป็นค่าจริงก่อนใช้งานครับ!
