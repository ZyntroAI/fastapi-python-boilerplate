# --- WhatsApp Cloud API ---
# Meta Graph API token สำหรับ WhatsApp Cloud API
WHATSAPP_TOKEN=EAAGm0PX4ZCpsBAKZC...

# Phone ID ของ WhatsApp Business (ตัวเลขล้วน)
WHATSAPP_PHONE_ID=123456789012345

# เบอร์โทรศัพท์ผู้ดูแลระบบ (international format, ไม่มี +)
ADMIN_PHONE=66820050603

# API version (มี default อยู่แล้วในสคริปต์ ถ้าอยาก override ให้ใส่เอง)
WHATSAPP_API_VER=v18.0


# --- BytePlus API ---
# Access key สำหรับ BytePlus
BYTEPLUS_ACCESS_KEY=your_access_key_here

# Secret key สำหรับ BytePlus
BYTEPLUS_SECRET_KEY=your_secret_key_here

# Region ที่คุณใช้งาน (เช่น ap-singapore, us-east-1)
BYTEPLUS_REGION=ap-singapore
