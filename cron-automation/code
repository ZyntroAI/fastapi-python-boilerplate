## 📡 Angular Service (เชื่อมต่อกับ Backend)

```typescript
// src/app/services/api.service.ts
@Injectable({ providedIn: 'root' })
export class ApiService {
  private apiUrl = environment.apiUrl || 'http://localhost:8000';

  // Workflow API
  executeWorkflow(id: string): Observable<ExecutionResult> {
    return this.http.post<ExecutionResult>(
      `${this.apiUrl}/api/workflows/${id}/execute`, {}
    );
  }

  toggleWorkflow(id: string): Observable<Workflow> {
    return this.http.post<Workflow>(
      `${this.apiUrl}/api/workflows/${id}/toggle`, {}
    );
  }

  // Job API
  executeJob(id: string): Observable<ExecutionResult> {
    return this.http.post<ExecutionResult>(
      `${this.apiUrl}/api/jobs/${id}/execute`, {}
    );
  }

  toggleJob(id: string): Observable<CronJob> {
    return this.http.post<CronJob>(
      `${this.apiUrl}/api/jobs/${id}/toggle`, {}
    );
  }
}
```

