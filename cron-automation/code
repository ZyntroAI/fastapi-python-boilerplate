นี่คือโค้ดตัวอย่างการเพิ่ม WebSocket Endpoint บน FastAPI เพื่อรัน Subprocess (Shell/Python Script) แล้ว stream stdout/stderr ออกมาแบบ Real-Time พร้อมทั้งโค้ด Angular Component / Service สำหรับรับข้อความมาแสดงผลบน UI ครับ
1. FastAPI Backend Implementation
สร้างหรืออัปเดตไฟล์ router สำหรับ WebSocket (เช่น backend/routers/execution_ws.py หรือนำไปรวมไว้ใน main.py):
# backend/routers/execution_ws.py
import asyncio
from fastapi import APIRouter, WebSocket, WebSocketDisconnect

router = APIRouter(prefix="/ws", tags=["websocket"])

@router.websocket("/execution/{job_id}")
async def websocket_execution_logs(websocket: WebSocket, job_id: str):
    """
    WebSocket endpoint สำหรับรัน script/command และ stream log กลับไปยัง client แบบ Real-time
    """
    await websocket.accept()
    
    # สมมติคำสั่งที่ต้องการรันตาม job_id (หรือดึง script path จาก DB)
    # ตัวอย่างนี้เป็นการจำลอง command ที่ส่ง log ออกมาเรื่อยๆ
    command = ["python3", "-u", "-c", f"""
import time
print('Starting Job ID: {job_id}...')
for i in range(1, 6):
    print(f'Processing step {{i}}/5...')
    time.sleep(1)
print('Job Execution Completed Successfully!')
"""]

    try:
        # สร้าง Async Subprocess และ Pipe stdout/stderr
        process = await asyncio.create_subprocess_exec(
            *command,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE
        )

        async def stream_reader(stream, log_type: str):
            """อ่านข้อมูลจาก stream แล้วส่งผ่าน WebSocket"""
            while True:
                line = await stream.readline()
                if not line:
                    break
                text = line.decode("utf-8", errors="replace").rstrip()
                # ส่ง JSON payload กลับไปยัง Angular
                await websocket.send_json({
                    "type": log_type,
                    "message": text
                })

        # อ่าน stdout และ stderr พร้อมกัน
        await asyncio.gather(
            stream_reader(process.stdout, "stdout"),
            stream_reader(process.stderr, "stderr")
        )

        # รอให้ process ทำงานเสร็จ
        return_code = await process.wait()
        await websocket.send_json({
            "type": "status",
            "message": f"Process exited with code {return_code}",
            "code": return_code
        })

    except WebSocketDisconnect:
        print(f"Client disconnected for job: {job_id}")
    except Exception as e:
        try:
            await websocket.send_json({"type": "error", "message": str(e)})
        except Exception:
            pass
    finally:
        try:
            await websocket.close()
        except Exception:
            pass

