2. Angular Frontend Implementation
2.1 WebSocket Service (src/app/services/websocket.service.ts)
import { Injectable } from '@angular/core';
import { Observable, Subject } from 'rxjs';

export interface LogMessage {
  type: 'stdout' | 'stderr' | 'status' | 'error';
  message: string;
  code?: number;
}

@Injectable({
  providedIn: 'root'
})
export class WebSocketService {
  private socket?: WebSocket;
  private logSubject = new Subject<LogMessage>();

  public connectJobLogs(jobId: string): Observable<LogMessage> {
    const wsUrl = `ws://localhost:8000/ws/execution/${jobId}`;
    this.socket = new WebSocket(wsUrl);

    this.socket.onopen = () => {
      this.logSubject.next({ type: 'status', message: 'WebSocket Connected' });
    };

    this.socket.onmessage = (event) => {
      try {
        const data: LogMessage = JSON.parse(event.data);
        this.logSubject.next(data);
      } catch (err) {
        this.logSubject.next({ type: 'stdout', message: event.data });
      }
    };

    this.socket.onerror = (error) => {
      this.logSubject.next({ type: 'error', message: 'WebSocket Connection Error' });
    };

    this.socket.onclose = () => {
      this.logSubject.next({ type: 'status', message: 'WebSocket Connection Closed' });
    };

    return this.logSubject.asObservable();
  }

  public disconnect(): void {
    if (this.socket) {
      this.socket.close();
      this.socket = undefined;
    }
  }
}

2.2 Live Log Viewer Component (src/app/components/log-viewer.component.ts)
import { Component, OnDestroy, ElementRef, ViewChild } from '@angular/core';
import { CommonModule } from '@angular/common';
import { Subscription } from 'rxjs';
import { WebSocketService, LogMessage } from '../services/websocket.service';

@Component({
  selector: 'app-log-viewer',
  standalone: true,
  imports: [CommonModule],
  template: `
    <div class="log-container">
      <div class="actions">
        <button (click)="startStreaming('job-123')">Start Streaming Log (Job 123)</button>
        <button (click)="stopStreaming()">Disconnect</button>
      </div>

      <div class="terminal" #terminalContainer>
        <div *ngFor="let log of logs" [ngClass]="log.type">
          <span class="timestamp">[{{ getTimestamp() }}]</span>
          <span class="type">[{{ log.type | uppercase }}]</span>
          <span class="text">{{ log.message }}</span>
        </div>
      </div>
    </div>
  `,
  styles: [`
    .log-container { margin: 16px; }
    .actions { margin-bottom: 12px; display: flex; gap: 8px; }
    .terminal {
      background-color: #1e1e1e;
      color: #d4d4d4;
      font-family: 'Courier New', Courier, monospace;
      padding: 12px;
      border-radius: 6px;
      height: 350px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
    }
    .stdout { color: #4ec9b0; }
    .stderr { color: #f44747; }
    .status { color: #ce9178; font-style: italic; }
    .error { color: #ff0000; font-weight: bold; }
    .timestamp { color: #858585; margin-right: 8px; }
    .type { margin-right: 8px; }
  `]
})
export class LogViewerComponent implements OnDestroy {
  @ViewChild('terminalContainer') private terminalContainer!: ElementRef;
  logs: LogMessage[] = [];
  private sub?: Subscription;

  constructor(private wsService: WebSocketService) {}

  startStreaming(jobId: string): void {
    this.logs = [];
    this.stopStreaming();

    this.sub = this.wsService.connectJobLogs(jobId).subscribe({
      next: (log) => {
        this.logs.push(log);
        this.scrollToBottom();
      }
    });
  }

  stopStreaming(): void {
    if (this.sub) {
      this.sub.unsubscribe();
    }
    this.wsService.disconnect();
  }

  private scrollToBottom(): void {
    setTimeout(() => {
      if (this.terminalContainer) {
        this.terminalContainer.nativeElement.scrollTop = 
          this.terminalContainer.nativeElement.scrollHeight;
      }
    }, 50);
  }

  getTimestamp(): string {
    return new Date().toLocaleTimeString();
  }

  ngOnDestroy(): void {
    this.stopStreaming();
  }
}

จุดสำคัญที่ควรรู้
 * Unbuffered Output: ใน FastAPI Subprocess เมื่อรันคำสั่ง Python ให้ใส่ flag -u (Unbuffered) เพื่อให้ Python ส่ง output ออกมาทาง stdout ทันทีโดยไม่ต้องรอให้ buffer เต็ม
 * Auto Auto-Scroll: ใน Angular component มีการใช้ scrollToBottom() เพื่อให้หน้าจอ Terminal เลื่อนลงอัตโนมัติเมื่อมี Log บรรทัดใหม่เข้ามา
