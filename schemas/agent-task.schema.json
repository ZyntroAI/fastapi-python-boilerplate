{
"$schema": "https://json-schema.org/draft/2020-12/schema",
"title": "AgentTask",
"type": "object",
"required": [
"task_id",
"action"
],
"properties": {
"task_id": {
"type": "string",
"minLength": 1
},
"action": {
"type": "string",
