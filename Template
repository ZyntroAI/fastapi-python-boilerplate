// ---------------------------------------------
// Helpers
// ---------------------------------------------
function formatDate(dateStr) {
  if (!dateStr) return "ไม่ระบุ";
  const d = new Date(dateStr);
  return d.toLocaleDateString("th-TH", { day: "numeric", month: "short", year: "numeric" });
}

function daysUntil(dateStr) {
  if (!dateStr) return null;
  const diff = new Date(dateStr) - new Date();
  return Math.ceil(diff / (1000 * 60 * 60 * 24));
}

function researcherName(id, researchers) {
  return researchers.find((r) => r.researcher_id === id)?.full_name ?? "ไม่ทราบชื่อ";
}

// ---------------------------------------------
// Small building blocks
// ---------------------------------------------
function StatusBadge({ status }) {
  const cfg = STATUS_CONFIG[status] ?? STATUS_CONFIG.draft;
  return (
    <span className={`inline-flex items-center gap-1.5 rounded-full ${cfg.bg} px-2.5 py-1 text-xs font-medium ${cfg.text}`}>
      <span className={`h-1.5 w-1.5 rounded-full ${cfg.dot}`} />
      {cfg.label}
    </span>
  );
}

function PriorityTag({ priority }) {
  const cfg = PRIORITY_CONFIG[priority] ?? PRIORITY_CONFIG.medium;
  return (
    <span className={`inline-flex items-center rounded-md px-2 py-0.5 text-xs font-medium ring-1 ${cfg.ring} ${cfg.text}`}>
      {cfg.label}
    </span>
  );
}

function DeadlinePill({ dateStr }) {
  const days = daysUntil(dateStr);
  if (days === null) return <span className="text-xs text-slate-400">ไม่มีกำหนดส่ง</span>;
  const overdue = days < 0;
  const soon = days >= 0 && days <= 7;
  return (
    <span
      className={`inline-flex items-center gap-1 text-xs font-medium ${
        overdue ? "text-rose-600" : soon ? "text-amber-600" : "text-slate-500"
      }`}
    >
      <Calendar className="h-3.5 w-3.5" />
      {overdue ? `เลยกำหนด ${Math.abs(days)} วัน` : `เหลือ ${days} วัน`}
    </span>
  );
}

// ---------------------------------------------
// Create / Edit modal
// ---------------------------------------------
function ProjectFormModal({ open, onClose, onSave, researchers }) {
  const [form, setForm] = useState({
    title: "",
    description: "",
    status: "draft",
    priority: "medium",
    lead_researcher_id: researchers[0]?.researcher_id ?? "",
    deadline_at: "",
  });

  if (!open) return null;

  const handleChange = (key) => (e) => setForm((f) => ({ ...f, [key]: e.target.value }));

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!form.title.trim()) return;
    onSave({
      ...form,
      lead_researcher_id: Number(form.lead_researcher_id),
      started_at: new Date().toISOString().slice(0, 10),
    });
    onClose();
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4">
      <div className="w-full max-w-lg rounded-2xl bg-white p-6 shadow-xl">
        <div className="mb-5 flex items-center justify-between">
          <h2 className="text-lg font-semibold text-slate-900">สร้างโครงการวิจัยใหม่</h2>
          <button
            onClick={onClose}
            className="rounded-full p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            aria-label="ปิด"
          >
            <X className="h-4 w-4" />
          </button>
        </div>

        <form onSubmit={handleSubmit} className="space-y-4">
          <div>
            <label className="mb-1 block text-sm font-medium text-slate-700">ชื่อโครงการ</label>
            <input
              value={form.title}
              onChange={handleChange("title")}
              required
              placeholder="เช่น ผลกระทบของ RAG ต่อความแม่นยำของ LLM"
              className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
            />
          </div>

          <div>
            <label className="mb-1 block text-sm font-medium text-slate-700">รายละเอียด</label>
            <textarea
              value={form.description}
              onChange={handleChange("description")}
              rows={3}
              placeholder="สรุปเป้าหมายและขอบเขตของโครงการ"
              className="w-full resize-none rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
            />
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">สถานะ</label>
              <select
                value={form.status}
                onChange={handleChange("status")}
                className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
              >
                {STATUS_OPTIONS.map((s) => (
                  <option key={s} value={s}>
                    {STATUS_CONFIG[s].label}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">ความสำคัญ</label>
              <select
                value={form.priority}
                onChange={handleChange("priority")}
                className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
              >
                {PRIORITY_OPTIONS.map((p) => (
                  <option key={p} value={p}>
                    {PRIORITY_CONFIG[p].label}
                  </option>
                ))}
              </select>
            </div>
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">หัวหน้าโครงการ</label>
              <select
                value={form.lead_researcher_id}
                onChange={handleChange("lead_researcher_id")}
                className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
              >
                {researchers.map((r) => (
                  <option key={r.researcher_id} value={r.researcher_id}>
                    {r.full_name}
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label className="mb-1 block text-sm font-medium text-slate-700">กำหนดส่ง</label>
              <input
                type="date"
                value={form.deadline_at}
                onChange={handleChange("deadline_at")}
                className="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
              />
            </div>
          </div>

          <div className="flex justify-end gap-2 pt-2">
            <button
              type="button"
              onClick={onClose}
              className="rounded-lg px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100"
            >
              ยกเลิก
            </button>
            <button
              type="submit"
              className="rounded-lg bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700"
            >
              บันทึกโครงการ
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}

// ---------------------------------------------
// Project card
// ---------------------------------------------
function ProjectCard({ project, researchers, onOpen }) {
  return (
    <button
      onClick={() => onOpen(project)}
      className="group flex w-full flex-col rounded-xl border border-slate-200 bg-white p-4 text-left transition hover:border-slate-300 hover:shadow-sm"
    >
      <div className="mb-3 flex items-start justify-between gap-3">
        <StatusBadge status={project.status} />
        <PriorityTag priority={project.priority} />
      </div>

      <h3 className="mb-1 line-clamp-2 text-sm font-semibold text-slate-900">{project.title}</h3>
      <p className="mb-4 line-clamp-2 text-xs text-slate-500">{project.description}</p>

      <div className="mt-auto flex items-center justify-between border-t border-slate-100 pt-3 text-xs text-slate-500">
        <span className="inline-flex items-center gap-1.5">
          <User className="h-3.5 w-3.5" />
          {researcherName(project.lead_researcher_id, researchers)}
        </span>
        <DeadlinePill dateStr={project.deadline_at} />
      </div>
    </button>
  );
}

// ---------------------------------------------
// Detail drawer
// ---------------------------------------------
function ProjectDrawer({ project, researchers, onClose, onStatusChange }) {
  if (!project) return null;

  return (
    <div className="fixed inset-0 z-40 flex justify-end bg-slate-900/30">
      <div className="h-full w-full max-w-md overflow-y-auto bg-white shadow-2xl">
        <div className="flex items-start justify-between border-b border-slate-100 p-5">
          <div>
            <StatusBadge status={project.status} />
            <h2 className="mt-2 text-lg font-semibold text-slate-900">{project.title}</h2>
          </div>
          <button
            onClick={onClose}
            className="rounded-full p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            aria-label="ปิด"
          >
            <X className="h-4 w-4" />
          </button>
        </div>

        <div className="space-y-5 p-5">
          <p className="text-sm leading-relaxed text-slate-600">{project.description || "ไม่มีรายละเอียด"}</p>

          <div className="grid grid-cols-2 gap-4 rounded-xl bg-slate-50 p-4 text-sm">
            <div>
              <div className="text-xs text-slate-400">หัวหน้าโครงการ</div>
              <div className="mt-0.5 font-medium text-slate-800">
                {researcherName(project.lead_researcher_id, researchers)}
              </div>
            </div>
            <div>
              <div className="text-xs text-slate-400">ความสำคัญ</div>
              <div className="mt-0.5">
                <PriorityTag priority={project.priority} />
              </div>
            </div>
            <div>
              <div className="text-xs text-slate-400">เริ่มโครงการ</div>
              <div className="mt-0.5 font-medium text-slate-800">{formatDate(project.started_at)}</div>
            </div>
            <div>
              <div className="text-xs text-slate-400">กำหนดส่ง</div>
              <div className="mt-0.5 font-medium text-slate-800">{formatDate(project.deadline_at)}</div>
            </div>
          </div>

          <div>
            <label className="mb-1.5 block text-xs font-medium text-slate-500">เปลี่ยนสถานะ</label>
            <div className="flex flex-wrap gap-2">
              {STATUS_OPTIONS.map((s) => (
                <button
                  key={s}
                  onClick={() => onStatusChange(project.project_id, s)}
                  className={`rounded-full px-3 py-1.5 text-xs font-medium transition ${
                    project.status === s
                      ? "bg-slate-900 text-white"
                      : "bg-slate-100 text-slate-600 hover:bg-slate-200"
                  }`}
                >
                  {STATUS_CONFIG[s].label}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}

// ---------------------------------------------
// Main component
// ---------------------------------------------
export default function ProjectManagement() {
  const [projects, setProjects] = useState(SEED_PROJECTS);
  const [researchers] = useState(SEED_RESEARCHERS);
  const [query, setQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState("all");
  const [showForm, setShowForm] = useState(false);
  const [activeProject, setActiveProject] = useState(null);

  const filteredProjects = useMemo(() => {
    return projects.filter((p) => {
      const matchesQuery = p.title.toLowerCase().includes(query.toLowerCase());
      const matchesStatus = statusFilter === "all" || p.status === statusFilter;
      return matchesQuery && matchesStatus;
    });
  }, [projects, query, statusFilter]);

  const counts = useMemo(() => {
    const c = { all: projects.length };
    STATUS_OPTIONS.forEach((s) => (c[s] = projects.filter((p) => p.status === s).length));
    return c;
  }, [projects]);

  const handleCreate = (newProject) => {
    setProjects((prev) => [
      { ...newProject, project_id: Math.max(0, ...prev.map((p) => p.project_id)) + 1 },
      ...prev,
    ]);
  };

  const handleStatusChange = (projectId, status) => {
    setProjects((prev) =>
      prev.map((p) => (p.project_id === projectId ? { ...p, status } : p))
    );
    setActiveProject((prev) => (prev && prev.project_id === projectId ? { ...prev, status } : prev));
  };

  return (
    <div className="min-h-screen bg-slate-50 p-6 sm:p-10">
      <div className="mx-auto max-w-6xl">
        {/* Header */}
        <div className="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 className="text-2xl font-semibold tracking-tight text-slate-900">โครงการวิจัย</h1>
            <p className="mt-1 text-sm text-slate-500">
              จัดการโครงการวิจัยทั้งหมด {projects.length} โครงการ
            </p>
          </div>
          <button
            onClick={() => setShowForm(true)}
            className="inline-flex items-center gap-2 self-start rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-slate-700"
          >
            <Plus className="h-4 w-4" />
            โครงการใหม่
          </button>
        </div>

        {/* Filters */}
        <div className="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center">
          <div className="relative flex-1">
            <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
            <input
              value={query}
              onChange={(e) => setQuery(e.target.value)}
              placeholder="ค้นหาชื่อโครงการ..."
              className="w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-9 pr-3 text-sm focus:border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
            />
          </div>

          <div className="flex flex-wrap gap-1.5">
            <button
              onClick={() => setStatusFilter("all")}
              className={`rounded-full px-3 py-1.5 text-xs font-medium transition ${
                statusFilter === "all"
                  ? "bg-slate-900 text-white"
                  : "bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-100"
              }`}
            >
              ทั้งหมด ({counts.all})
            </button>
            {STATUS_OPTIONS.map((s) => (
              <button
                key={s}
                onClick={() => setStatusFilter(s)}
                className={`rounded-full px-3 py-1.5 text-xs font-medium transition ${
                  statusFilter === s
                    ? "bg-slate-900 text-white"
                    : "bg-white text-slate-600 ring-1 ring-slate-200 hover:bg-slate-100"
                }`}
              >
                {STATUS_CONFIG[s].label} ({counts[s] ?? 0})
              </button>
            ))}
          </div>
        </div>

        {/* Grid */}
        {filteredProjects.length === 0 ? (
          <div className="rounded-xl border border-dashed border-slate-300 bg-white py-16 text-center">
            <p className="text-sm text-slate-500">ไม่พบโครงการที่ตรงกับเงื่อนไข</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {filteredProjects.map((project) => (
              <ProjectCard
                key={project.project_id}
                project={project}
                researchers={researchers}
                onOpen={setActiveProject}
              />
            ))}
          </div>
        )}
      </div>

      <ProjectFormModal
        open={showForm}
        onClose={() => setShowForm(false)}
        onSave={handleCreate}
        researchers={researchers}
      />

      <ProjectDrawer
        project={activeProject}
        researchers={researchers}
        onClose={() => setActiveProject(null)}
        onStatusChange={handleStatusChange}
      />
    </div>
  );
}


