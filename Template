  archived: { label: "เก็บถาวร", dot: "bg-slate-300", text: "text-slate-500", bg: "bg-slate-50" },
};

const PRIORITY_CONFIG = {
  low: { label: "ต่ำ", ring: "ring-slate-200", text: "text-slate-500" },
