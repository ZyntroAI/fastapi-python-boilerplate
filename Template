  high: { label: "สูง", ring: "ring-orange-200", text: "text-orange-600" },
  critical: { label: "วิกฤต", ring: "ring-rose-200", text: "text-rose-600" },
};

const STATUS_OPTIONS = Object.keys(STATUS_CONFIG);
const PRIORITY_OPTIONS = Object.keys(PRIORITY_CONFIG);

