4. Configuration (app/core/config.py)
Handles environment variables for API keys and settings.

python
from pydantic_settings import BaseSettings

class Settings(BaseSettings):
    APP_NAME: str = "ManusAI"
    VERSION: str = "1.0.0"
    LLM_API_KEY: str = "your-llm-key"
    NOTION_TOKEN: str = "your-notion-token"
    GITHUB_TOKEN: str = "your-github-token"
    
    class Config:
        env_file = ".env"

settings = Settings()


