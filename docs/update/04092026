"""
📊 Monitoring Engine — Metrics · Alerts · Health Checks
- Prometheus integration · latency tracking · error rates · budget alerts
"""
from prometheus_fastapi_instrumentator import Instrumentator, metrics
from prometheus_client import Counter, Histogram, Gauge
from typing import Dict, Optional
import time

# ── Metrics Definitions ──
REQUEST_COUNT = Counter(
    "api_requests_total", "Total requests",
    ["method", "endpoint", "status_code"]
)
REQUEST_LATENCY = Histogram(
    "api_request_duration_seconds", "Request latency",
    ["endpoint"], buckets=[0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0]
)
ACTIVE_REQUESTS = Gauge("api_active_requests", "Active requests")
BUDGET_REMAINING = Gauge("user_budget_remaining", "Remaining token budget", ["user_id"])
CACHE_HIT_RATE = Gauge("cache_hit_rate_percent", "Cache hit rate %")

class MonitoringEngine:
    """Central monitoring — auto-instrument FastAPI"""
    
    def __init__(self):
        self.hits = 0
        self.misses = 0
        self._alerts: list[dict] = []

    def instrument_app(self, app):
        """Attach Prometheus metrics to FastAPI app"""
        Instrumentator()\
            .add(metrics.request_size())\
            .add(metrics.response_size())\
            .add(metrics.status_codes())\
            .add(metrics.latency())\
            .add(metrics.requests())\
            .instrument(app)

    # ── Cache Metrics ──
    def record_cache_hit(self):
        self.hits += 1
        self._update_hit_rate()

    def record_cache_miss(self):
        self.misses += 1
        self._update_hit_rate()

    def _update_hit_rate(self):
        total = self.hits + self.misses
        rate = (self.hits / total * 100) if total > 0 else 0
        CACHE_HIT_RATE.set(rate)

    # ── Budget Alerts ──
    def update_budget(self, user_id: str, remaining: int, daily_limit: int):
        """Update budget gauge + trigger alerts at thresholds"""
        BUDGET_REMAINING.labels(user_id=user_id).set(remaining)
        pct = remaining / daily_limit if daily_limit > 0 else 0
        
        if pct < 0.1:  # < 10% remaining
            self._trigger_alert("critical", f"User {user_id}: Budget <10% remaining!")
        elif pct < 0.25:  # < 25%
            self._trigger_alert("warning", f"User {user_id}: Budget low")

    # ── Health Checks ──
    async def check_health(self) -> Dict[str, str]:
        """System health status"""
        return {
            "status": "healthy",
            "cache_hit_rate_pct": round(self.hits/(self.hits+self.misses)*100, 1) if (self.hits+self.misses) > 0 else 0,
            "alerts_pending": len(self._alerts)
        }

    def _trigger_alert(self, level: str, message: str):
        """Log + queue alert"""
        self._alerts.append({
            "level": level,
            "message": message,
            "timestamp": time.time()
        })

    def get_recent_alerts(self, limit: int = 10):
        return self._alerts[-limit:]


# Global instance
monitoring = MonitoringEngine()
 
 
 
 
