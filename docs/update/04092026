"""
⚙️ Workflow Engine — Standardize · Automate · Validate
- Status transitions · Templates · Auto-actions · Validation
"""
from enum import Enum
from typing import Dict, List, Callable, Optional
from pydantic import BaseModel, Field

class WorkflowStatus(str, Enum):
    """Standard lifecycle — aligned with GitHub & project boards"""
    TODO = "todo"
    TRIAGE = "triage"
    IN_PROGRESS = "in_progress"
    IN_REVIEW = "in_review"
    TESTING = "testing"
    RESOLVED = "resolved"
    BLOCKED = "blocked"

class WorkflowTransition(BaseModel):
    """Define allowed state changes"""
    from_status: Optional[WorkflowStatus]
    to_status: WorkflowStatus
    required_conditions: List[str] = Field(default_factory=list)
    auto_actions: List[str] = Field(default_factory=list)

class WorkflowDefinition(BaseModel):
    name: str
    initial_status: WorkflowStatus
    transitions: List[WorkflowTransition]
    auto_assign: bool = True
    auto_notify: bool = True

class WorkflowEngine:
    """Enforce consistent workflows across all items"""
    
    def __init__(self):
        self._workflows: Dict[str, WorkflowDefinition] = {}
        self._hooks: Dict[str, List[Callable]] = {}
        self._register_default_workflows()

    def _register_default_workflows(self):
        """Standard development workflow"""
        self._workflows["development"] = WorkflowDefinition(
            name="Development Lifecycle",
            initial_status=WorkflowStatus.TODO,
            transitions=[
                WorkflowTransition(None, WorkflowStatus.TRIAGE),
                WorkflowTransition(WorkflowStatus.TRIAGE, WorkflowStatus.IN_PROGRESS),
                WorkflowTransition(WorkflowStatus.IN_PROGRESS, WorkflowStatus.IN_REVIEW, 
                                   required_conditions=["pr_created", "tests_pass"]),
                WorkflowTransition(WorkflowStatus.IN_REVIEW, WorkflowStatus.TESTING,
                                   required_conditions=["review_approved"]),
                WorkflowTransition(WorkflowStatus.TESTING, WorkflowStatus.RESOLVED,
                                   required_conditions=["tests_pass", "approved"]),
                WorkflowTransition("*", WorkflowStatus.BLOCKED),
            ]
        )

    def can_transition(self, workflow_name: str, from_status: Optional[WorkflowStatus], 
                       to_status: WorkflowStatus, conditions: Dict[str, bool] = None) -> tuple[bool, str]:
        """Validate if a status change is allowed"""
        workflow = self._workflows.get(workflow_name)
        if not workflow:
            return False, f"Workflow '{workflow_name}' not found"
        
        conditions = conditions or {}
        for t in workflow.transitions:
            if t.to_status == to_status:
                if t.from_status is None or t.from_status == from_status or t.from_status == "*":
                    # Check required conditions
                    missing = [c for c in t.required_conditions if not conditions.get(c, False)]
                    if missing:
                        return False, f"Missing required: {', '.join(missing)}"
                    return True, "OK"
        return False, f"Cannot transition from {from_status} to {to_status}"

    def register_hook(self, event: str, callback: Callable):
        """Register auto-action on workflow events"""
        if event not in self._hooks:
            self._hooks[event] = []
        self._hooks[event].append(callback)

    async def trigger_transition(self, item_id: str, workflow_name: str, 
                                 from_status: WorkflowStatus, to_status: WorkflowStatus, **kwargs):
        """Execute transition + run hooks"""
        allowed, reason = self.can_transition(workflow_name, from_status, to_status, kwargs)
        if not allowed:
            return {"success": False, "reason": reason}
        
        # Run post-transition hooks
        for hook in self._hooks.get(f"post_{to_status}", []):
            await hook(item_id, workflow_name, from_status, to_status, **kwargs)
        
        return {"success": True, "new_status": to_status}


# Global instance
workflow_engine = WorkflowEngine()
 
 
 
 
