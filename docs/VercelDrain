fastapi>=0.115 uvicorn>=0.32 python-multipart

# vercel_receiver.py
from fastapi import FastAPI, Request, HTTPException
import hmac, hashlib, os

app = FastAPI()
SECRET = os.environ.get("VERCEL_SECRET", "")

@app.post("/drain")
async def receive(req: Request):
    body = await req.body()
    sig = req.headers.get("x-vercel-signature", "")
    
    # Verify HMAC
    computed = hmac.new(SECRET.encode(), body, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(computed, sig):
        raise HTTPException(403, "Invalid signature")
    
    # Respond NOW — process async later! ⚠️
    return {"status": "accepted"}</code></pre>
