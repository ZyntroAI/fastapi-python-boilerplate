                            <th class="p-3 font-bold text-slate-600">Cause</th>
                            <th class="p-3 font-bold text-slate-600">Resolution</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y">
                        <tr>
                            <td class="p-3 font-semibold text-red-700">Drain auto-disabled</td>
                            <td class="p-3">Endpoint timed out (>5s) or returned 5xx repeatedly</td>
                            <td class="p-3">Return 200 OK immediately → queue work → re-enable in Vercel Dashboard</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-amber-700">No logs arriving</td>
                            <td class="p-3">Wrong URL / secret expired / IP blocked</td>
                            <td class="p-3">Verify endpoint responds at /health → reset secret → check firewall</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-blue-700">Missing fields</td>
                            <td class="p-3">Source filters too narrow</td>
                            <td class="p-3">Check drain config: enable Function + Edge; uncheck Static unless needed</td>
                        </tr>
                        <tr>
                            <td class="p-3 font-semibold text-purple-700">Cost unexpectedly high</td>
                            <td class="p-3">Infinite loop OR static logs enabled at full volume</td>
                            <td class="p-3">Disable Static Access Logs → verify receiver doesn't log to same drain</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 text-xs py-5 mt-8 border-t border-slate-800">
        <p class="text-center">Vercel Drains Explorer • Built for ZyntroAI • Based on official Vercel documentation</p>
    </footer>

    <!-- JavaScript -->
    <script>
        // ── Shared Data ──────────────────────────────────────
        const sampleLog = {
            requestId: "iad1:abc123xyz",
            source: "function",
            statusCode: 200,
            message: "GET /api/users 200 in 42ms",
            environment: "production",
            timestamp: new Date().toISOString()
        };
        let chartVolume, chartCost;

        // ── Tab Switch ───────────────────────────────────────
        function switchTab(id) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('bg-emerald-600','text-white','font-semibold');
                b.classList.add('text-slate-300','hover:bg-slate-800');
            });
            document.getElementById(`tab-${id}`).classList.remove('hidden');
            const btn = document.getElementById(`tab-btn-${id}`);
            btn.classList.add('bg-emerald-600','text-white','font-semibold');
            btn.classList.remove('text-slate-300','hover:bg-slate-800');
            
            // Resize charts when visible
            setTimeout(() => {
                if (chartVolume) chartVolume.resize();
                if (chartCost) chartCost.resize();
            }, 50);
        }

        // ── Payload Simulator ────────────────────────────────
        let currentType = 'log';
        function setType(t) {
            currentType = t;
            document.getElementById('t-log').className = t==='log' 
                ? 'py-2 px-3 text-xs font-medium rounded-lg border border-emerald-600 bg-emerald-50 text-emerald-700 font-semibold'
                : 'py-2 px-3 text-xs font-medium rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50';
            document.getElementById('t-trace').className = t==='trace'
                ? 'py-2 px-3 text-xs font-medium rounded-lg border border-purple-600 bg-purple-50 text-purple-700 font-semibold'
                : 'py-2 px-3 text-xs font-medium rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50';
            updateSim();
        }
        function updateSim() {
            const out = document.getElementById('payload-out');
            out.textContent = currentType === 'log'
                ? JSON.stringify(sampleLog, null, 2) + '\n' + JSON.stringify({...sampleLog, requestId: 'iad1:def456'}, null, 2)
                : JSON.stringify({resourceSpans: [{spans: [{name: "db-query", duration: 150}] }]}, null, 2);
        }
        function copyPayload() {
            navigator.clipboard.writeText(document.getElementById('payload-out').textContent);
            alert("Copied!");
        }

        // ── Cost Calculator ──────────────────────────────────
        function calcCost() {
            const req = parseFloat(document.querySelectorAll('input[type=range]')[0].value);
            const sz = parseFloat(document.querySelectorAll('input[type=range]')[1].value);
            const samp = parseFloat(document.querySelectorAll('input[type=range]')[2].value);
            const excludeStatic = document.querySelectorAll('input[type=checkbox]')[1].checked;

            document.getElementById('lbl-req').textContent = `${req}M`;
            document.getElementById('lbl-sz').textContent = `${sz} KB`;
            document.getElementById('lbl-samp').textContent = `${samp}%`;

            let rawGB = (req * 1e6 * sz * 1024) / 1024**3;
            let optGB = rawGB * (samp / 100);
            if (excludeStatic) optGB *= 0.2;

            const rawCost = Math.ceil(rawGB / 5) * 10;
            const optCost = Math.ceil(optGB / 5) * 10 || 2;

            document.getElementById('calc-vol').textContent = `${optGB.toFixed(2)} GB`;
            document.getElementById('calc-cost').textContent = `$${optCost.toFixed(2)}/mo`;
            document.getElementById('savings').textContent = `$${(rawCost - optCost).toFixed(2)}`;

            if (chartCost) {
                chartCost.data.datasets[0].data = [rawCost, optCost];
                chartCost.update();
            }
        }

        // ── Charts Init ──────────────────────────────────────
        function initCharts() {
            // Volume Donut Chart
            chartVolume = new Chart(document.getElementById('volumeChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Static Access Logs (~82%)', 'Function Logs (~12%)', 'Edge Logs (~5%)', 'Build Logs (~1%)'],
                    datasets: [{
                        data: [82, 12, 5, 1],
                        backgroundColor: ['#3b82f6', '#10b981', '#8b5cf6', '#f59e0b'],
                        borderWidth: 2, borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } }
                }
            });

            // Cost Bar Chart
            chartCost = new Chart(document.getElementById('costChart'), {
                type: 'bar',
                data: {
                    labels: ['Unoptimized', 'Your Settings'],
                    datasets: [{
                        label: 'Monthly Cost ($)',
                        data: [30, 6],
                        backgroundColor: ['#ef4444', '#10b981'],
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true } },
                    plugins: { legend: { display: false } }
                }
            });
        }

        // ── On Load ───────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            initCharts();
            updateSim();
            calcCost();
        });
    </script>
</body>
</html>
