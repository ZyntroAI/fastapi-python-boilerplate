// components/CostProjection.tsx
'use client';

import { useState, useMemo } from 'react';

type Props = {
  // Pre-fill from actual metrics
  initialRequests?: number;
  initialAvgDurationMs?: number;
  initialImageSizeGbGzip?: number;
  initialImageSizeGbZstd?: number;
};

export default function CostProjection({
  initialRequests = 1_200_000,
  initialAvgDurationMs = 180,
  initialImageSizeGbGzip = 1.2,
  initialImageSizeGbZstd = 0.78,
}: Props) {
  const [requests, setRequests] = useState(initialRequests);
  const [avgDuration, setAvgDuration] = useState(initialAvgDurationMs);
  const [concurrency, setConcurrency] = useState(5);
  const [alwaysOnInstances, setAlwaysOnInstances] = useState(1);
  const [zstdEnabled, setZstdEnabled] = useState(true);

  // Pricing assumptions — adjust to your actual pricing
  // Vercel-style: $0.000024 per GB-s Active CPU (example)
  // Render-style: $7 / month per 0.5 CPU / 512MB always-on
  const PRICING = {
    activeCpuPerGbSecond: 0.000024, // $0.000024 / GB-s
    memoryGb: 0.5,
    coldStartPenaltyGzip: 1.4, // seconds
    coldStartPenaltyZstd: 0.35,
    alwaysOnMonthly: 7, // per instance
    freeActiveCpuGbSec: 100000, // free quota
    freeRequests: 1_000_000,
  };

  const calc = useMemo(() => {
    const activeGbSeconds = (requests * (avgDuration / 1000) * PRICING.memoryGb);
    const billableGbSeconds = Math.max(0, activeGbSeconds - PRICING.freeActiveCpuGbSec);
    const activeCpuCost = billableGbSeconds * PRICING.activeCpuPerGbSecond;

    // Cold start cost approximation
    const imageSize = zstdEnabled ? initialImageSizeGbZstd : initialImageSizeGbGzip;
    const coldStartPerBoot = zstdEnabled ? PRICING.coldStartPenaltyZstd : PRICING.coldStartPenaltyGzip;
    // Assume 1 cold start per 100 requests with concurrency factor
    const coldStarts = Math.ceil(requests / (100 * concurrency));
    const coldStartGbSeconds = coldStarts * coldStartPerBoot * PRICING.memoryGb;

    const totalActiveCost = activeCpuCost + (coldStartGbSeconds * PRICING.activeCpuPerGbSecond);

    // Always-on cost: flat + still pay for overage? Simplified to flat
    const alwaysOnCost = alwaysOnInstances * PRICING.alwaysOnMonthly;
    const alwaysOnP95 = 120; // ms, always warm
    const scaleToZeroP95 = 180;
    const scaleToZeroP99 = zstdEnabled ? 420 : 1400;

    const saving = totalActiveCost - alwaysOnCost;
    const winner = totalActiveCost < alwaysOnCost ? 'active' : 'alwaysOn';

    // zstd benefit
    const sizeSaving = ((initialImageSizeGbGzip - initialImageSizeGbZstd) / initialImageSizeGbGzip) * 100;
    const timeSaving = ((PRICING.coldStartPenaltyGzip - PRICING.coldStartPenaltyZstd) / PRICING.coldStartPenaltyGzip) * 100;

    return {
      activeGbSeconds,
      billableGbSeconds,
      totalActiveCost,
      alwaysOnCost,
      winner,
      saving: Math.abs(saving),
      coldStarts,
      imageSize,
      alwaysOnP95,
      scaleToZeroP95,
      scaleToZeroP99,
      sizeSaving,
      timeSaving,
      requestsInFree: Math.min(requests, PRICING.freeRequests),
    };
  }, [requests, avgDuration, concurrency, alwaysOnInstances, zstdEnabled, initialImageSizeGbGzip, initialImageSizeGbZstd]);

  return (
    <div className="w-full max-w-4xl mx-auto bg-[#0a0a0a] border border-zinc-800 rounded-2xl p-6 text-zinc-100 font-sans">
      {/* Header */}
      <div className="flex items-center justify-between mb-6">
        <div>
          <h3 className="text-lg font-semibold">Cost Projection: Active CPU vs Always-On</h3>
          <p className="text-sm text-zinc-400">Based on your last 30 days • Streaming snapshot model (VCR + Fluid)</p>
        </div>
        <div className="flex items-center gap-2">
          <label className="flex items-center gap-2 text-xs bg-zinc-900 border border-zinc-800 rounded-full px-3 py-1.5 cursor-pointer">
            <input type="checkbox" checked={zstdEnabled} onChange={e => setZstdEnabled(e.target.checked)} className="accent-violet-500" />
            zstd build
          </label>
        </div>
      </div>

      {/* Controls */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <Control label={`Requests: ${requests.toLocaleString()}`} min={10000} max={10000000} step={10000} value={requests} onChange={setRequests} />
        <Control label={`Avg Duration: ${avgDuration}ms`} min={20} max={2000} step={10} value={avgDuration} onChange={setAvgDuration} />
        <Control label={`Concurrency: ${concurrency}`} min={1} max={50} step={1} value={concurrency} onChange={setConcurrency} />
      </div>

