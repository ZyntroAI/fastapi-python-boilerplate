            <div className="flex justify-between"><span>p95 / p99</span><span>{calc.scaleToZeroP95}ms / {calc.scaleToZeroP99}ms</span></div>
          </div>
          <div className="mt-3 text-[11px] text-zinc-500">
            {requests <= PRICING.freeRequests ? `✓ ${calc.requestsInFree.toLocaleString()} requests in free tier` : `Free tier: ${PRICING.freeRequests.toLocaleString()} req + 100k GB-s`}
          </div>
        </div>

        {/* Always-On Card */}
        <div className={`rounded-xl p-4 border ${calc.winner === 'alwaysOn' ? 'bg-emerald-500/10 border-emerald-500/40' : 'bg-zinc-900 border-zinc-800'}`}>
          <div className="flex items-center justify-between mb-2">
            <span className="text-sm font-medium flex items-center gap-2">
              <span className="w-2 h-2 bg-zinc-400 rounded-full" /> Always-On (Render-style)
            </span>
            {calc.winner === 'alwaysOn' && <span className="text-[10px] bg-emerald-500 text-black px-2 py-0.5 rounded-full">CHEAPER</span>}
          </div>
          <div className="text-2xl font-bold">${calc.alwaysOnCost.toFixed(2)}<span className="text-sm font-normal text-zinc-400">/mo flat</span></div>
          <div className="mt-3 space-y-1 text-xs text-zinc-400">
            <div className="flex justify-between"><span>Instances</span><span>{alwaysOnInstances} × Starter ($7)</span></div>
            <div className="flex justify-between"><span>Supports</span><span>Workers, Cron, Disks, WS</span></div>
            <div className="flex justify-between"><span>p95 / p99</span><span>{calc.alwaysOnP95}ms / {calc.alwaysOnP95 + 20}ms</span></div>
            <div className="flex justify-between"><span>Tradeoff</span><span>No scale-to-zero, disk = max 1 instance</span></div>
          </div>
          <div className="mt-3">
            <input type="range" min={1} max={5} value={alwaysOnInstances} onChange={e => setAlwaysOnInstances(parseInt(e.target.value))} className="w-full accent-zinc-500" />
          </div>
        </div>
      </div>

      {/* zstd insight */}
      <div className="rounded-xl bg-[#111] border border-zinc-800 p-4 mb-6 flex items-start gap-3">
        <div className="w-8 h-8 rounded-lg bg-zinc-900 border border-zinc-800 flex items-center justify-center text-sm">⚡</div>
        <div className="flex-1">
          <div className="text-sm font-medium">VCR Snapshot + zstd = {calc.timeSaving.toFixed(0)}% faster cold start</div>
          <div className="text-xs text-zinc-400 mt-1">
            Your image: <span className="text-zinc-200">{initialImageSizeGbGzip.toFixed(2)}GB gzip</span> → <span className="text-emerald-400">{initialImageSizeGbZstd.toFixed(2)}GB zstd</span> ({calc.sizeSaving.toFixed(0)}% smaller).
            On Fluid, this cuts VHS snapshot creation time and streaming decompress time. Recommended build: <code className="bg-zinc-900 px-1.5 py-0.5 rounded text-[11px]">compression=zstd,compression-level=3,force-compression=true</code>
          </div>
        </div>
        <button onClick={() => setZstdEnabled(!zstdEnabled)} className="text-xs bg-white text-black px-3 py-1.5 rounded-full font-medium hover:bg-zinc-200">
          {zstdEnabled ? 'Disable' : 'Enable'} zstd
        </button>
      </div>

      {/* Recommendation */}
      <div className="flex items-center justify-between rounded-full bg-zinc-900 border border-zinc-800 px-4 py-3">
        <div className="text-sm">
          {calc.winner === 'active' ? (
            <>💡 <span className="font-medium">Stay on scale-to-zero</span> — you save ${calc.saving.toFixed(2)}/mo at current traffic. Upgrade when you need workers/disks.</>
          ) : (
            <>💡 <span className="font-medium">Switch to always-on</span> — you save ${calc.saving.toFixed(2)}/mo + get stable p99. Keep API on free, move worker to paid.</>
          )}
        </div>
        <div className="flex gap-2">
          <button className="text-xs bg-zinc-800 border border-zinc-700 px-3 py-1.5 rounded-full">Keep Free Tier</button>
          <button className="text-xs bg-white text-black px-3 py-1.5 rounded-full font-semibold">Upgrade to Starter</button>
        </div>
      </div>

      <div className="mt-4 text-[11px] text-zinc-500 text-center">
        Pricing uses Vercel Active CPU $0.000024/GB-s and Render Starter $7/instance as reference. Replace PRICING const with your actual.
      </div>
    </div>
  );
}

function Control({ label, min, max, step, value, onChange }: { label: string; min: number; max: number; step: number; value: number; onChange: (v: number) => void }) {
  return (
    <div className="bg-zinc-900 border border-zinc-800 rounded-xl p-3">
      <div className="text-xs text-zinc-400 mb-2">{label}</div>
      <input type="range" min={min} max={max} step={step} value={value} onChange={e => onChange(Number(e.target.value))} className="w-full accent-violet-500" />
    </div>
  );
}
