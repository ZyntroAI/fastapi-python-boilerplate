## ⚡ Extension 1 — Batch Processing (50% COST SAVINGS!)

> **POST /v1/messages/batches** — Process thousands of requests asynchronously at **half the price**

### 🐍 Python — Batch Client
```python
    # ─── Batch Processing — 50% Cost Reduction ────────────────────
    def create_batch(
        self,
        requests: List[Dict[str, Any]],
        batch_id: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        Submit up to 100,000 messages as a batch.
        Cost: 50% cheaper than individual requests!
        """
        try:
            batch_requests = []
            for req in requests:
                batch_requests.append({
                    "custom_id": req.get("custom_id", f"req_{len(batch_requests)}"),
                    "params": {
                        "model": req.get("model", self.config.model),
                        "max_tokens": req.get("max_tokens", self.config.max_tokens),
                        "messages": [{"role": "user", "content": req["prompt"]}],
                        **({"system": req["system_prompt"]} if "system_prompt" in req else {}),
                    }
                })

            response = self.client.messages.batches.create(
                requests=batch_requests,
                idempotency_key=batch_id,
            )

            return {
                "ok": True,
                "batch_id": response.id,
                "status": response.status,
                "request_count": response.request_counts.total,
                "cost_saving": "50%",
            }

        except Exception as e:
            return {"ok": False, "error": "batch_error", "message": str(e)}

    def get_batch_status(self, batch_id: str) -> Dict[str, Any]:
        """Check batch progress — status: pending / in_progress / completed / expired / failed"""
        try:
            batch = self.client.messages.batches.retrieve(batch_id)
            return {
                "ok": True,
                "batch_id": batch.id,
                "status": batch.status,
                "succeeded": batch.request_counts.succeeded,
                "failed": batch.request_counts.failed,
                "total": batch.request_counts.total,
                "completed_at": str(batch.completed_at) if batch.completed_at else None,
            }
        except Exception as e:
            return {"ok": False, "message": str(e)}

    def get_batch_results(self, batch_id: str) -> List[Dict[str, Any]]:
        """Fetch completed batch output when status = 'completed'"""
        try:
            results = []
            for item in self.client.messages.batches.results(batch_id):
                results.append({
                    "custom_id": item.custom_id,
                    "status": item.result.type,
                    "content": item.result.message.content[0].text if hasattr(item.result.message, 'content') else None,
                    "error": item.result.error if item.result.type == "error" else None,
                })
            return results
        except Exception as e:
            return [{"error": str(e)}]
```

