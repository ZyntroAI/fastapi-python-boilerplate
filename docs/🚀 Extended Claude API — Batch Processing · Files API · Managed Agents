## 🤖 Extension 3 — Managed Agents API (Beta)

> **Stateful cloud sandboxes → run code, use tools, persist sessions**

### 🐍 Python — Managed Agents
```python
    # ─── Managed Agents (Beta) ────────────────────────────────────
    def create_agent_session(
        self,
        agent_spec: Dict[str, Any],
        environment_id: Optional[str] = None,
    ) -> Dict[str, Any]:
        """
        Create a stateful agent session in a cloud sandbox.
        agent_spec = {
            "model": "claude-3-7-sonnet-20250219",
            "instructions": "You are a DevSecOps auditor...",
            "tools": [...],
        }
        """
        try:
            session = self.client.sessions.create(
                agent_specification=agent_spec,
                environment_id=environment_id,
            )
            return {
                "ok": True,
                "session_id": session.id,
                "status": session.status,
                "stream_url": session.events_stream_url,
            }
        except Exception as e:
            return {"ok": False, "message": str(e)}

    def list_sessions(self, limit: int = 10):
        """List active agent sessions."""
        try:
            sessions = self.client.sessions.list(limit=limit)
            return [{"id": s.id, "status": s.status, "created": str(s.created_at)} for s in sessions.data]
        except Exception as e:
            return [{"error": str(e)}]
