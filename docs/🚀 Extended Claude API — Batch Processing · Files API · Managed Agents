## 📁 Extension 2 — Files API (Knowledge Base & Long Context)

> **POST /v1/files** — Upload PDFs, docs, data → reuse across conversations

### 🐍 Python — Files API
```python
    # ─── Files API ────────────────────────────────────────────────
    def upload_file(
        self,
        file_path: str,
        purpose: str = "document"  # document / batch
    ) -> Dict[str, Any]:
        """Upload file → reuse across many API calls."""
        try:
            with open(file_path, "rb") as f:
                file = self.client.files.create(
                    file=f,
                    purpose=purpose,
                )
            return {
                "ok": True,
                "file_id": file.id,
                "name": file.filename,
                "size_bytes": file.bytes,
                "purpose": file.purpose,
            }
        except Exception as e:
            return {"ok": False, "message": str(e)}

    def list_files(self) -> List[Dict[str, Any]]:
        """List all uploaded files."""
        try:
            files = self.client.files.list()
            return [
                {"id": f.id, "name": f.filename, "size": f.bytes, "purpose": f.purpose}
                for f in files.data
            ]
        except Exception as e:
            return [{"error": str(e)}]

    def attach_file_message(self, file_id: str, question: str, **kwargs):
        """Send question with attached file reference."""
        return self.send_message(
            prompt=f"File ID: {file_id}\n\n{question}",
            **kwargs
        )
```

### 🟦 TypeScript — Files API
```typescript
  // ─── Files API ────────────────────────────────────────────────
  async uploadFile(filePath: string, purpose: "document" | "batch" = "document") {
    try {
      const fs = await import("fs/promises");
      const fileBuffer = await fs.readFile(filePath);
      const file = await this.client.files.create({
        file: {
          name: filePath.split("/").pop()!,
          content: fileBuffer,
        },
        purpose,
      });
      return {
        ok: true as const,
        fileId: file.id,
        filename: file.filename,
        size: file.bytes,
      };
    } catch (err) {
      return { ok: false, error: String(err) } as const;
    }
  }

  async listFiles() {
    try {
      const files = await this.client.files.list();
      return files.data.map(f => ({
        id: f.id,
        filename: f.filename,
        bytes: f.bytes,
        purpose: f.purpose,
      }));
    } catch (err) {
      return [];
    }
  }
