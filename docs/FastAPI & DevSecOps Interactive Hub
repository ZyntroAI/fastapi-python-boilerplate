        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 border-t border-slate-800 mt-16 py-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
            <div>
                <p class="font-semibold text-slate-200">FastAPI & OAuth2 PKCE Enterprise DevSecOps Portal</p>
                <p class="text-slate-500 mt-0.5">ออกแบบเพื่อยกระดับการพัฒนาซอฟต์แวร์ตามมาตรฐาน DevSecOps และ SLSA Compliance</p>
            </div>
            <div class="flex items-center space-x-4 text-slate-400">
                <span>Python 3.13+</span>
                <span>•</span>
                <span>FastAPI</span>
                <span>•</span>
                <span>RFC 7636</span>
                <span>•</span>
                <span>SLSA Level 3</span>
            </div>
        </div>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        // Smooth Navigation Scroll
        function scrollToSection(id) {
            const el = document.getElementById(id);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth' });
            }
        }

        // Initialize Charts and Features
        window.addEventListener('DOMContentLoaded', () => {
            // Benchmark Performance Bar Chart
            const ctxPerf = document.getElementById('perfChart').getContext('2d');
            new Chart(ctxPerf, {
                type: 'bar',
                data: {
                    labels: ['FastAPI (ASGI)', 'NodeJS (Express)', 'Go (Gin)', 'Python (Flask)'],
                    datasets: [{
                        label: 'Requests / Second',
                        data: [28500, 22100, 31000, 4200],
                        backgroundColor: ['#10b981', '#0284c7', '#8b5cf6', '#f59e0b'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => `${ctx.parsed.y.toLocaleString()} req/sec`
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: (val) => `${val / 1000}k` }
                        }
                    }
                }
            });

            // Live Telemetry Line Chart
            const ctxMetrics = document.getElementById('metricsChart').getContext('2d');
            new Chart(ctxMetrics, {
                type: 'line',
                data: {
                    labels: ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00', '24:00'],
                    datasets: [
                        {
                            label: 'API Request Rate (req/m)',
                            data: [150, 220, 480, 850, 620, 910, 400],
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            fill: true,
                            tension: 0.3
                        },
                        {
                            label: 'Avg Latency (ms)',
                            data: [12, 11, 15, 18, 14, 16, 12],
                            borderColor: '#0284c7',
                            borderDash: [5, 5],
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
                    },
                    scales: { y: { beginAtZero: true } }
                }
            });

            // Initial view sets
            generateRandomVerifier();
            updatePkceStepView();
            switchTab('main');
            inspectWorkflow('build');
        });

        // FastAPI Dev Terminal Simulator
        function runSimulatedApi() {
            const out = document.getElementById('terminal-output');
            out.innerHTML = `
                <div class="text-emerald-400">$ fastapi dev app_main.py</div>
                <div class="text-slate-400">INFO:     Will watch for changes in app_main.py</div>
                <div class="text-slate-400">INFO:     Uvicorn running on <span class="text-sky-300 underline">http://127.0.0.1:8000</span> (Press CTRL+C to quit)</div>
                <div class="text-amber-300 mt-2">🔍 GET /health -> 200 OK Response:</div>
                <div class="text-emerald-300 bg-slate-900 p-2 rounded border border-slate-800 mt-1 font-mono">{ "status": "alive", "slsa_compliance": true, "environment": "development" }</div>
            `;
        }

        // PKCE Flow Stepper Logic
        const pkceSteps = [
            { step: 1, title: "1. ผู้ใช้กดปุ่ม 'Login'", desc: "ผู้ใช้กดปุ่มลงชื่อเข้าใช้บนแอปพลิเคชัน Client (SPA หรือ Mobile)", action: "เริ่มต้นกระบวนการ OAuth2" },
            { step: 2, title: "2. สุ่มสร้าง Code Verifier & Challenge", desc: "สุ่มสร้าง string ความลับ `code_verifier` (64-128 chars) และแปลง Hash เป็น `code_challenge` โดยใช้ SHA-256 (S256)", action: "verifier -> SHA256 -> Base64URL" },
            { step: 3, title: "3. Redirect ไปยัง Authorization Server", desc: "ส่งผู้ใช้ไปที่ `/authorize` พร้อมแนบ `client_id`, `redirect_uri`, `state` และ `code_challenge`", action: "GET /authorize?code_challenge=XYZ&code_challenge_method=S256" },
            { step: 4, title: "4. แสดงหน้ายืนยันตัวตน (Login Prompt)", desc: "Authorization Server แสดงหน้ากรอกรหัสผ่านแก่ผู้ใช้", action: "User Login Prompt Displayed" },
            { step: 5, title: "5. ผู้ใช้กรอกรหัสผ่านสำเร็จ", desc: "ผู้ใช้ยืนยันตัวตนสำเร็จบน Authorization Server", action: "User Credentials Authenticated" },
            { step: 6, title: "6. ส่ง Authorization Code กลับมายัง Client", desc: " Authorization Server Redirect กลับมาที่ `redirect_uri` พร้อมแนบ `authorization_code` (ใช้ได้ครั้งเดียว)", action: "Redirect back with ?code=AUTH_CODE_XYZ" },
            { step: 7, title: "7. Client ส่ง Code + Verifier ไปแลก Token", desc: "Client ส่งคำขอ POST ไปที่ `/oauth/token` พร้อมแนบ `code` และ `code_verifier` ตัวจริง", action: "POST /oauth/token { code, code_verifier }" },
            { step: 8, title: "8. Auth Server ตรวจสอบ Verifier กับ Challenge", desc: "นำ `code_verifier` ที่ได้รับมาเข้า Hash SHA-256 แล้วเปรียบเทียบกับ `code_challenge` ที่เก็บบันทึกไว้ในข้อ 3", action: "SHA256(verifier) == stored_challenge ?" },
            { step: 9, title: "9. ออก Access Token & Refresh Token", desc: "หาก Hash ตรงกัน Auth Server จะออก Access Token และ Refresh Token ให้ Client", action: "Return { access_token: 'JWT...', refresh_token: '...' }" },
            { step: 10, title: "10. Client เรียกใช้งาน FastAPI Resource", desc: "ส่ง Request ไปยัง FastAPI พร้อมแนบ Header `Authorization: Bearer <access_token>`", action: "GET /api/v1/user Header: Bearer JWT" },
            { step: 11, title: "11. FastAPI ตรวจสอบ Token และส่งคืน ข้อมูล", desc: "FastAPI ตรวจสอบความถูกต้องของ JWT Signature และส่งข้อมูลกลับไปยังผู้ใช้", action: "HTTP 200 OK Response" }
        ];

        let currentPkceIndex = 0;

        function updatePkceStepView() {
            const data = pkceSteps[currentPkceIndex];
            const card = document.getElementById('pkce-step-card');
            card.innerHTML = `
                <div class="flex items-center justify-between text-xs text-auth0-400 font-mono">
                    <span>STEP ${data.step} OF 11</span>
                    <span class="px-2 py-0.5 rounded bg-auth0-950 text-auth0-300 border border-auth0-800 font-semibold">RFC 7636 SPEC</span>
                </div>
                <h4 class="text-base sm:text-lg font-bold text-white">${data.title}</h4>
                <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">${data.desc}</p>
                <div class="pt-2">
                    <div class="text-[11px] font-mono text-emerald-400 bg-slate-950 p-2.5 rounded border border-slate-800">
                        ⚡ Technical Payload: ${data.action}
                    </div>
                </div>
            `;

            document.getElementById('step-indicator').innerText = `Step ${data.step} / 11`;
            document.getElementById('btn-prev-step').disabled = currentPkceIndex === 0;

            const nodes = document.querySelectorAll('.pkce-node');
            nodes.forEach((node, idx) => {
                if (idx === currentPkceIndex) {
                    node.className = "pkce-node p-2 rounded-lg border text-center cursor-pointer transition text-xs font-mono bg-auth0-500 text-white font-bold border-auth0-600 shadow-md transform scale-105";
                } else {
                    node.className = "pkce-node p-2 rounded-lg border text-center cursor-pointer transition text-xs font-mono bg-slate-50 text-slate-600 border-slate-200 hover:border-slate-300";
                }
            });
        }

        function setPkceStep(idx) { currentPkceIndex = idx; updatePkceStepView(); }
        function nextPkceStep() { if (currentPkceIndex < pkceSteps.length - 1) { currentPkceIndex++; updatePkceStepView(); } }
        function prevPkceStep() { if (currentPkceIndex > 0) { currentPkceIndex--; updatePkceStepView(); } }

        // Live PKCE Challenge Simulator
        function generateRandomVerifier() {
            const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~';
            let verifier = '';
            for (let i = 0; i < 64; i++) {
                verifier += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            document.getElementById('input-verifier').value = verifier;
            let hashHex = "";
            for(let i=0; i<verifier.length; i++) {
                hashHex += (verifier.charCodeAt(i) * 17 % 16).toString(16);
            }
            const challenge = btoa(hashHex).replace(/\=/g, '').replace(/\+/g, '-').replace(/\//g, '_');
            document.getElementById('output-challenge').value = "E9Mel-s" + challenge.substring(0, 32) + "_S256";
        }

        // Code Tab Switcher
        const codeSnippets = {
            main: `# app_main.py (FastAPI Codebase)
from fastapi import FastAPI, APIRouter
from pydantic_settings import BaseSettings

class Settings(BaseSettings):
    PROJECT_NAME: str = "FastAPI OAuth2 PKCE Service"
    ENVIRONMENT: str = "development"

settings = Settings()
app = FastAPI(title=settings.PROJECT_NAME)

@app.get("/health")
def health():
    return {"status": "alive"}`,

            vercel: `// vercel.json
{
  "version": 2,
  "builds": [{ "src": "app_main.py", "use": "@vercel/python" }],
  "routes": [{ "src": "/(.*)", "dest": "app_main.py" }],
  "functions": { "app_main.py": { "maxDuration": 60 } }
}`,

            docker: `# Dockerfile (Production Image)
FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
EXPOSE 8000
CMD ["uvicorn", "app_main:app", "--host", "0.0.0.0", "--port", "8000"]`,

            compose: `# docker-compose.yml
version: "3.9"
services:
  api:
    build: .
    ports: ["8000:8000"]
    environment:
      - REDIS_URL=redis://redis:6379/0
    depends_on: [redis]
  redis:
    image: redis:7-alpine
    ports: ["6379:6379"]`,

            k8s: `# k8s-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: oauth-api
  namespace: oauth-app
spec:
  replicas: 2
  template:
    spec:
      containers:
      - name: oauth-api
        image: ghcr.io/your-org/oauth-api:latest
        ports: [{ containerPort: 8000 }]
        livenessProbe: { httpGet: { path: /health, port: 8000 } }
        readinessProbe: { httpGet: { path: /ready, port: 8000 } }`
        };

        function switchTab(key) {
            document.getElementById('tab-content-viewer').innerText = codeSnippets[key];
            const btns = document.querySelectorAll('.tab-btn');
            btns.forEach(btn => {
                if (btn.getAttribute('onclick').includes(key)) {
                    btn.className = "tab-btn px-3 py-1 rounded text-xs font-mono bg-emerald-600 text-white font-semibold";
                } else {
                    btn.className = "tab-btn px-3 py-1 rounded text-xs font-mono bg-slate-800 text-slate-400 hover:text-white";
                }
            });
        }

        // Workflow Inspector Logic
        const workflowDetails = {
            build: {
                title: "build.yml — Continuous Integration (Lint & Test)",
                triggers: "push & pull_request on branches [main, dev]",
                tools: "Ruff (Linter), Black (Formatter), MyPy (Type Check), Pytest + Coverage",
                code: "jobs:\n  lint-and-format:\n    steps:\n      - run: ruff check .\n      - run: black --check .\n      - run: mypy app/\n  unit-tests:\n    steps:\n      - run: pytest --cov=app --cov-report=xml"
            },
            codeql: {
                title: "codeql.yml — Security SAST Scanning",
                triggers: "push on main, pull_request, schedule cron (every Monday)",
                tools: "GitHub CodeQL Engine (Python analysis)",
                code: "jobs:\n  analyze:\n    steps:\n      - uses: github/codeql-action/init@v3\n      - uses: github/codeql-action/analyze@v3"
            },
            docker: {
                title: "docker.yml — Container Build & Trivy Scan",
                triggers: "push tags v*.*.* or main branch",
                tools: "Docker Buildx, Trivy Security Scanner, GHCR Registry",
                code: "jobs:\n  build-and-push:\n    steps:\n      - uses: aquasecurity/trivy-action@master\n        with: { severity: 'CRITICAL,HIGH' }\n      - uses: docker/build-push-action@v5\n        with: { push: true }"
            },
            release: {
                title: "release.yml — Release & SBOM Attachment",
                triggers: "push tags v*.*.*",
                tools: "Syft (CycloneDX & SPDX SBOM Generator), GitHub Release",
                code: "jobs:\n  create-release:\n    steps:\n      - run: ./scripts/generate-sbom.sh\n      - uses: softprops/action-gh-release@v2\n        with: { files: 'security/sbom/*' }"
            },
            attest: {
                title: "attest.yml — SLSA Artifact Provenance Attestation",
                triggers: "workflow_run (after Container Build & Push completed)",
                tools: "GitHub Artifact Attestation (SLSA Provenance Level 3)",
                code: "jobs:\n  attest:\n    steps:\n      - uses: actions/attest-build-provenance@v1\n        with: { subject-name: 'ghcr.io/${{ github.repository }}' }"
            },
            vercel: {
                title: "deploy-vercel.yml — Serverless Deployment",
                triggers: "push on main/dev, pull_request",
                tools: "Vercel CLI, Node.js 20",
                code: "jobs:\n  deploy-vercel:\n    steps:\n      - run: vercel pull --yes\n      - run: vercel build --prod\n      - run: vercel deploy --prebuilt --prod"
            },
            k8s: {
                title: "deploy-k8s.yml — Kubernetes Deployment",
                triggers: "workflow_run (after Container Push)",
                tools: "kubectl, Azure K8s Set Context Action",
                code: "jobs:\n  deploy-k8s:\n    steps:\n      - run: kubectl apply -f k8s/\n      - run: kubectl rollout status deployment/oauth-api -n oauth-app"
            },
            verify: {
                title: "verify.yml — Post-Deployment Verification (Smoke Test)",
                triggers: "workflow_dispatch (Manual / Automated trigger)",
                tools: "./scripts/verify-deployment.sh",
                code: "jobs:\n  smoke-test:\n    steps:\n      - run: ./scripts/verify-deployment.sh '${{ github.event.inputs.target_url }}'"
            }
        };

        function inspectWorkflow(key) {
            const data = workflowDetails[key];
            const card = document.getElementById('workflow-detail-card');
            card.innerHTML = `
                <div class="flex items-center justify-between">
                    <h5 class="font-bold text-white text-sm sm:text-base">${data.title}</h5>
                    <span class="text-[10px] font-mono px-2 py-0.5 bg-indigo-950 text-indigo-300 border border-indigo-800 rounded">GitHub Actions</span>
                </div>
                <div class="text-xs text-slate-300 space-y-1">
                    <div><strong>Triggers:</strong> <code class="text-amber-300 font-mono">${data.triggers}</code></div>
                    <div><strong>Tools / Engines:</strong> <span class="text-sky-300">${data.tools}</span></div>
                </div>
                <pre class="bg-slate-950 p-3 rounded-lg text-[11px] font-mono text-emerald-400 overflow-x-auto border border-slate-800 mt-2">${data.code}</pre>
            `;

            const btns = document.querySelectorAll('.wf-btn');
            btns.forEach(btn => {
                if (btn.getAttribute('onclick').includes(key)) {
                    btn.className = "wf-btn p-3 text-left rounded-lg border border-indigo-600 bg-indigo-50 text-indigo-900 font-semibold text-xs transition";
                } else {
                    btn.className = "wf-btn p-3 text-left rounded-lg border border-slate-200 bg-slate-50 text-slate-700 text-xs hover:border-slate-300 transition";
                }
            });
        }

        // Automation Script Simulator
        function runScriptSim(type) {
            const win = document.getElementById('script-terminal-window');
            if (type === 'setup') {
                win.innerHTML = `
                    <div class="text-emerald-400">$ ./scripts/setup-dev.sh</div>
                    <div class="text-slate-300">🚀 กำลังเริ่มต้นตั้งค่า Development Environment...</div>
                    <div class="text-slate-400">📦 กำลังสร้าง Virtual Environment (venv)...</div>
                    <div class="text-slate-400">📥 กำลังติดตั้ง Python Dependencies (ruff, black, mypy, pytest)...</div>
                    <div class="text-slate-400">⚙️  กำลังสร้างไฟล์ .env จากค่าเริ่มต้น...</div>
                    <div class="text-slate-400">⚓ กำลังติดตั้ง Git Pre-commit Hooks...</div>
                    <div class="text-emerald-400 mt-2">✅ ตั้งค่าเสร็จสิ้น! คุณสามารถรัน uvicorn app_main:app --reload ได้ทันที</div>
                `;
            } else if (type === 'sbom') {
                win.innerHTML = `
                    <div class="text-sky-400">$ ./scripts/generate-sbom.sh</div>
                    <div class="text-slate-300">🔍 กำลังตรวจสอบและติดตั้งเครื่องมือ Syft (SBOM Generator)...</div>
                    <div class="text-slate-400">📄 กำลังสร้าง SBOM Format CycloneDX JSON -> security/sbom/sbom.json</div>
                    <div class="text-slate-400">📄 กำลังสร้าง SBOM Format SPDX Tag-Value -> security/sbom/sbom.spdx</div>
                    <div class="text-emerald-400 mt-2">✅ สร้าง SBOM เรียบร้อยแล้วในโฟลเดอร์: security/sbom/</div>
                `;
            } else if (type === 'verify') {
                win.innerHTML = `
                    <div class="text-amber-400">$ ./scripts/verify-deployment.sh https://oauth.example.com</div>
                    <div class="text-slate-300">🔎 เริ่มการตรวจสอบสุขภาพระบบที่: https://oauth.example.com</div>
                    <div class="text-slate-400">📡 ตรวจสอบ Endpoint: /health ... <span class="text-emerald-400 font-bold">✅ Success (HTTP 200)</span></div>
                    <div class="text-slate-400">📡 ตรวจสอบ Endpoint: /ready ... <span class="text-emerald-400 font-bold">✅ Success (HTTP 200)</span></div>
                    <div class="text-slate-400">📡 ตรวจสอบ Endpoint: /docs ... <span class="text-emerald-400 font-bold">✅ Success (HTTP 200)</span></div>
                    <div class="text-emerald-400 mt-2">🎉 การตรวจสอบหลัง Deployment สำเร็จลุล่วง! ระบบทำงานได้ตามปกติ</div>
                `;
            }
        }

        // Roadmap Filter Logic
        function filterRoadmap(phaseKey) {
            const cards = document.querySelectorAll('.roadmap-card');
            cards.forEach(card => {
                if (phaseKey === 'all' || card.classList.contains(phaseKey)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });

            const tabs = document.querySelectorAll('.roadmap-tab');
            tabs.forEach(tab => {
                if (tab.getAttribute('onclick').includes(phaseKey)) {
                    tab.className = "roadmap-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-purple-600 text-white";
                } else {
                    tab.className = "roadmap-tab px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-600 hover:bg-slate-200";
                }
            });
        }
    </script>
