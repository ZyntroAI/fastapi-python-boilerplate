ถ้าต้องการ **SQLite Backup + Telegram Alert** แบบ Production-friendly และทำง่ายที่สุด:

### Flow

```text
SQLite DB
   │
   ├─ backup ทุกวัน
   │
   ├─ gzip
   │
   ├─ เก็บ backup/
   │
   └─ ส่งแจ้งเตือน Telegram
```

---

## Python Script

```python
import sqlite3
import shutil
import gzip
import os
from datetime import datetime
import requests

DB_PATH = "app.db"
BACKUP_DIR = "backup"

BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")

os.makedirs(BACKUP_DIR, exist_ok=True)

timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

backup_file = f"{BACKUP_DIR}/app_{timestamp}.db"
compressed_file = f"{backup_file}.gz"

try:
    # SQLite Online Backup
    src = sqlite3.connect(DB_PATH)
    dst = sqlite3.connect(backup_file)

    src.backup(dst)

    dst.close()
    src.close()

    # Compress
    with open(backup_file, "rb") as f_in:
        with gzip.open(compressed_file, "wb") as f_out:
            shutil.copyfileobj(f_in, f_out)

    os.remove(backup_file)

    message = (
        f"✅ SQLite Backup Success\n"
        f"File: {os.path.basename(compressed_file)}"
    )

except Exception as e:
    message = f"❌ SQLite Backup Failed\n{str(e)}"

requests.post(
    f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage",
    json={
        "chat_id": CHAT_ID,
        "text": message
    }
)
```

