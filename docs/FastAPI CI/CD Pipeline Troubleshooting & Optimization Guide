Quick Reference: Health-First Workflow Template

If you copy only one thing, use this minimal pattern for any FastAPI + Postgres + Redis workflow:

```yaml
jobs:
  test:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16-alpine
        options: >-
          --health-cmd "pg_isready -U postgres -d testdb"
          --health-interval 5s --health-timeout 5s
          --health-retries 10 --health-start-period 10s
        ports: ["5432:5432"]
      redis:
        image: redis:7-alpine
        options: >-
          --health-cmd "redis-cli ping"
          --health-interval 5s --health-timeout 5s
          --health-retries 10 --health-start-period 5s
        ports: ["6379:6379"]
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
        with: { version: "0.8.4", python-version: "3.12", enable-cache: true }
      - run: uv sync --all-extras --dev
      - run: |
          for i in {1..30}; do pg_isready -h localhost -p 5432 && break; sleep 2; done
          for i in {1..30}; do redis-cli -h localhost -p 6379 ping && break; sleep 2; done
      - run: uv run alembic upgrade head
      - run: uv run pytest -n auto
```

This pattern eliminates 80% of the common failures by ensuring services are healthy, dependencies are cached, and migrations run before tests.
