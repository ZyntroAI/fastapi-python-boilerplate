 search-router/grafana-widget.yaml 
 
yaml
  
apiVersion: v1
kind: ConfigMap
metadata:
  name: zyntro-search-widget
  namespace: zyntroai-monitoring
data:
  search-panel.json: |
    {
      "type": "text",
      "title": "🔍 Unified Search",
      "gridPos": {"x":0,"y":0,"w":24,"h":4},
      "options": {
        "mode": "html",
        "content": `
        <div style="padding:12px">
          <div style="display:flex;gap:8px">
            <input id="zyntro-search-input" type="text" 
              placeholder="Search: merge freeze, flaky tests, runbooks, metrics..." 
              style="flex:1;padding:12px;border-radius:4px;border:2px solid #333;background:#1a1a1a;color:#fff;font-size:16px">
            <button id="zyntro-search-btn" style="padding:12px 24px;background:#36a64f;border:none;border-radius:4px;color:#fff;cursor:pointer;font-size:16px">Search</button>
          </div>
          <div id="zyntro-search-results" style="margin-top:16px"></div>
        </div>
        <script>
          const base = "https://search.yourdomain.com/api/v1";
          const input = document.getElementById("zyntro-search-input");
          const results = document.getElementById("zyntro-search-results");
          
          const doSearch = async () => {
            const q = input.value.trim();
            if(!q) return;
            results.innerHTML = "<p>Searching...</p>";
            try {
              const res = await fetch(`${base}/query?q=${encodeURIComponent(q)}&grouped=true`);
              const data = await res.json();
              results.innerHTML = Object.entries(data.groups || {}).map(([g, items]) => `
                <div style="margin-bottom:16px">
                  <h4 style="color:#8ab4f8;margin:8px 0">${g}</h4>
                  <ul style="margin:0;padding-left:16px">
                    ${items.map(i => `
                      <li style="margin:4px 0">
                        <a href="${i.url}" target="_blank" style="color:#4299e1">${i.title}</a>
                        <span style="color:#999;font-size:12px">— ${i.excerpt || ""}</span>
                      </li>
                    `).join("")}
                  </ul>
                </div>
              `).join("") || "<p>No results</p>";
            } catch(e) { results.innerHTML = `<p style="color:red">Error: ${e.message}</p>`; }
          };
          
          document.getElementById("zyntro-search-btn").addEventListener("click", doSearch);
          input.addEventListener("keydown", e => e.key==="Enter" && doSearch());
        </script>
        `
      }
    }
 
 
