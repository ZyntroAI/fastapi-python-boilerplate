🧩 Part 2: Slack  /search  Command Integration
 
 search-router/slack-search-command.yaml 
 
yaml
  
apiVersion: apps/v1
kind: Deployment
metadata:
  name: slack-search-handler
  namespace: zyntroai-monitoring
spec:
  replicas: 1
  selector: {matchLabels: {app: slack-search-handler}}
  template:
    metadata: {labels: {app: slack-search-handler}}
    spec:
      containers:
        - name: handler
          image: zyntroai/slack-search-handler:v1.0.0
          ports: [{containerPort: 3000}]
          env:
            - name: SEARCH_API
              value: "http://search-router:80/api/v1"
            - name: SLACK_SIGNING_SECRET
              valueFrom: {secretKeyRef: {name: slack-secrets, key: signing_secret}}
            - name: SLACK_TOKEN
              valueFrom: {secretKeyRef: {name: slack-secrets, key: bot_token}}
---
apiVersion: v1
kind: Service
metadata: {name: slack-search-handler, namespace: zyntroai-monitoring}
spec:
  selector: {app: slack-search-handler}
  ports: [{port: 80, targetPort: 3000}]
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: slack-search-ingress
  annotations: {nginx.ingress.kubernetes.io/ssl-redirect: "true"}
spec:
  rules:
    - host: "slack-search.yourdomain.com"
      http:
        paths: [{path: "/search", pathType: Prefix, backend: {service: {name: slack-search-handler, port:80}}}]
 
 
