📝 Example — Full Workflow
 
bash
  
# 1. Map site
MAP_ID=$(curl -X POST https://api.firecrawl.dev/v2/map \
  -H "Authorization: Bearer fc-KEY" \
  -d '{"url":"https://docs.example.com"}' | jq -r '.links[0]')

# 2. Scrape page
curl -X POST https://api.firecrawl.dev/v2/scrape \
  -H "Authorization: Bearer fc-KEY" \
  -d '{
    "url": "'"$MAP_ID"'",
    "formats": ["markdown"],
    "onlyMainContent": true
  }'
 
 
 
 
