# ════════════════════════════════════════════════════════════════════════
# FastAPI Boilerplate — ROOT environment template
# ════════════════════════════════════════════════════════════════════════
# Copy to .env (git-ignored) and fill in real values:
#
#     cp .env.example .env
#
# Every value below is a PLACEHOLDER for local development. Never commit a
# filled-in .env. Per-component templates live beside their code — see
# docs/ENVIRONMENT.md for the full layout and precedence rules.
# ════════════════════════════════════════════════════════════════════════

# ── Core app ─────────────────────────────────────────  app/core/main.py
ENV=local                          # local | vercel | production
APP_NAME=ZyntroAPI
APP_VERSION=0.1.0
LOG_LEVEL=INFO
PORT=8000
DEBUG=true

# CORS. FRONTEND_ORIGINS (comma-separated) wins; FRONTEND_ORIGIN is the
# single-origin fallback used when it is unset.
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000

# ── Auth / JWT ────────────────────────────────────  app/core/config.py
# This repo has TWO settings modules that both read .env, and they disagree on
# the JWT variable name:
#   app/core/config.py  → JWT_SECRET     (used by app/services/token_service.py)
#   app/config.py       → JWT_SECRET_KEY (used by app/core/security.py)
# Set both to the SAME value or tokens issued by one path will fail to verify
# on the other. Both default to the same insecure dev string.
JWT_SECRET=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# OAuth2 provider. OAUTH_CLIENT_SECRET is optional — the PKCE flow used by
# the callback does not require one.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# ── Data stores ────────────────────────────────────────────────────────
# Networking rule: inside docker-compose use the SERVICE name as host
# (postgres, redis); from the host machine use localhost + published port.
DATABASE_URL=postgresql+asyncpg://devops:DevOpsPass2026@localhost:5432/devai_platform
REDIS_URL=redis://localhost:6379/0

POSTGRES_USER=devops
POSTGRES_PASSWORD=DevOpsPass2026
POSTGRES_DB=devai_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Container stack substitutions ────────────────  docker-compose.yml
# docker-compose reads these for its ${VAR:-default} fallbacks. Change them
# before any deployment reachable from outside localhost.
DB_PASSWORD=DevOpsPass2026
MINIO_PASSWORD=MinioPass2026
GRAFANA_PASSWORD=Admin123!

# ── Credential broker (central; metadata-only, no raw secrets) ─────────
CREDENTIAL_BROKER_URL=http://broker:8080
BROKER_TOKEN=vault:ref:broker/fastapi

# ── Observability / cache ─────────────────────────────────────────────
# Read by app/config.py
SENTRY_DSN=
CACHE_ENABLED=true
CACHE_TTL=300

# Read by app/integrations/slack.py
SLACK_AST10_WEBHOOK=

# ── Provider keys ──────────────────────────────────────────────────────
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
BYTEPLUS_REGION=ap-southeast-1
# Read by the embedded snippet in docker/ZyntroAI.yml
GROQ_API_KEY=

# ── Reserved — planned infrastructure, not yet read by any code ────────
# Nothing in this repo consumes these today, so setting them has no effect.
# They are kept only so the broker/Vault rollout has a place to land. Confirm
# with:  grep -rn "VAULT_ADDR" --include='*.py' .
ALERT_SLACK_WEBHOOK=
VAULT_ADDR=
VAULT_ROLE=
