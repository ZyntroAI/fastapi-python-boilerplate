# ============================================================
# Application
# ============================================================

APP_NAME=OAuth FastAPI
APP_VERSION=1.0.0

# dev | test | staging | prod | production
ENV=dev

DEBUG=true


# ============================================================
# Server
# ============================================================

LOG_LEVEL=INFO


# ============================================================
# Database
# ============================================================

# Async SQLAlchemy
#
# PostgreSQL:
# postgresql+asyncpg://user:password@host:5432/database
#
# MySQL:
# mysql+aiomysql://user:password@host:3306/database

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Optional isolated test database
DATABASE_URL_TEST=postgresql+asyncpg://postgres:postgres@localhost:5432/app_test


# ============================================================
# CORS
# ============================================================

CORS_ORIGINS=http://localhost:3000

FRONTEND_ORIGIN=http://localhost:3000


# ============================================================
# OAuth
# ============================================================

OAUTH_PROVIDER=google

CLIENT_ID=
CLIENT_SECRET=

OAUTH_SCOPES=openid email profile

OAUTH_CALLBACK_PATH=/api/auth/callback

BASE_URL=http://localhost:8000


# ============================================================
# JWT
# ============================================================

JWT_SECRET=replace_with_a_long_random_secret

JWT_ALG=HS256

JWT_TTL_SECONDS=3600


# ============================================================
# OAuth Session Security
# ============================================================

SESSION_STATE_TTL_SECONDS=600


# ============================================================
# Observability
# ============================================================

METRICS_ENABLED=true

ENABLE_REQUEST_LOGS=true
