# ──────────────────────────────────────────────
# FastAPI Boilerplate — ENV TEMPLATE
# Copy to .env — NEVER commit real secrets.
# All values below are PLACEHOLDERS / references.
# ──────────────────────────────────────────────

# Core App
ENV=development
DEBUG=true
PORT=8000
APP_NAME=ZyntroAPI

# Credential Broker (central; metadata-only)
CREDENTIAL_BROKER_URL=http://broker:8080
BROKER_TOKEN=vault:ref:broker/fastapi

# Database (via broker — no direct secrets here)
DATABASE_URL=vault:ref:fastapi/db-url
DB_PASSWORD=vault:ref:fastapi/db-password

# Observability / Alerting (broker-resolved)
ALERT_SLACK_WEBHOOK=vault:ref:fastapi/slack-webhook
LOG_LEVEL=INFO

# Vault / Secret Manager
VAULT_ADDR=https://vault.zyntro.ai
VAULT_ROLE=fastapi-service
