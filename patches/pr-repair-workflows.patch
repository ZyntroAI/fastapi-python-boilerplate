-yaml
-  
-name: "🔧 Auto Debug & Rerun"
-
-# Trigger: When target workflows complete (success/failure/other)
-on:
-  workflow_run:
-    workflows:
-      - "CI"
-      - "Test"
-      - "Build"
-      - "CodeQL Advanced"
-      - "Dependency Review"
-    types: [completed]
-    branches: ["main"] # Only apply to main branch (adjust as needed)
-
-# Concurrency: Prevent duplicate runs for same workflow ID
-concurrency:
-  group: "auto-rerun-${{ github.event.workflow_run.id }}"
-  cancel-in-progress: false
-
-# Least-privilege permissions (CRITICAL)
-permissions:
-  actions: write       # Required: Rerun workflows, access run data
-  contents: read       # Required: Read repo/workflow files
-  issues: write        # Optional: Create issue on persistent failure
-  pull-requests: read  # Optional: Link to PR context
-
-jobs:
-  # --------------------------
-  # JOB 1: Diagnose & Classify Failure
-  # --------------------------
-  diagnose:
-    name: "🔍 Diagnose Failure"
-    if: github.event.workflow_run.conclusion == 'failure'
-    runs-on: ubuntu-latest
-    timeout-minutes: 10
-
-    outputs:
-      should_rerun: ${{ steps.classify.outputs.should_rerun }}
-      use_debug: ${{ steps.classify.outputs.use_debug }}
-      reason: ${{ steps.classify.outputs.reason }}
-      run_id: ${{ github.event.workflow_run.id }}
-
-    steps:
-      - name: Checkout Tools
-        uses: actions/checkout@v7
-        with:
-          sparse-checkout: |
-            .github/scripts/auto-debug
-          continue-on-error: true
-
-      - name: "📋 Get Run Metadata"
-        id: meta
-        env:
-          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
-          RUN_ID: ${{ github.event.workflow_run.id }}
-          REPO: ${{ github.repository }}
-        run: |
-          mkdir -p .diagnostics
-          gh run view "$RUN_ID" \
-            --repo "$REPO" \
-            --json id,attempt,workflowName,headSha,conclusion,html_url \
-            > .diagnostics/run-meta.json
-          cat .diagnostics/run-meta.json
-
-      - name: "📥 Download Failed Logs"
-        id: logs
-        env:
-          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
-          RUN_ID: ${{ github.event.workflow_run.id }}
-          REPO: ${{ github.repository }}
-        run: |
-          gh run view "$RUN_ID" \
-            --repo "$REPO" \
-            --log-failed \
-            > .diagnostics/failed-jobs.log || true
-          # Preview first 500 lines
-          head -n 500 .diagnostics/failed-jobs.log
-
-      - name: "🧠 Classify Failure Type"
-        id: classify
-        shell: bash
-        run: |
-          LOG_FILE=".diagnostics/failed-jobs.log"
-          META_FILE=".diagnostics/run-meta.json"
-
-          SHOULD_RERUN="false"
-          USE_DEBUG="false"
-          REASON="unknown_failure"
-          REASON_DESC="Unclassified failure; requiring manual review"
-
-          # --------------------------
-          # 1. TRANSIENT / INFRASTRUCTURE
-          # --------------------------
-          if grep -Eqi \
-            'timeout|timed out|connection reset|connection refused|502|503|504|429|rate limit|runner lost|runner disconnect|ECONNRESET|ETIMEDOUT|temporary failure|network error' \
-            "$LOG_FILE"; then
-            SHOULD_RERUN="true"
-            USE_DEBUG="true"
-            REASON="transient_infra"
-            REASON_DESC="Transient infrastructure/network failure"
-
-          # --------------------------
-          # 2. DEPENDENCY / PACKAGE ISSUE
-          # --------------------------
-          elif grep -Eqi \
-            'npm ERR|pnpm ERR|pip install|failed to fetch|network.*package|resolver error|registry down|temporary failure resolving' \
-            "$LOG_FILE"; then
-            SHOULD_RERUN="true"
-            USE_DEBUG="false"
-            REASON="dependency_network"
-            REASON_DESC="Dependency/registry network failure"
-
-          # --------------------------
-          # 3. RUNNER RESOURCE ISSUE
-          # --------------------------
-          elif grep -Eqi \
-            'no space left|disk full|ENOSPC|out of memory|Killed|resource exhausted' \
-            "$LOG_FILE"; then
-            SHOULD_RERUN="true"
-            USE_DEBUG="true"
-            REASON="runner_resource"
-            REASON_DESC="Runner resource limit (disk/memory)"
-
-          # --------------------------
-          # 4. PERMISSION / AUTH (STOP)
-          # --------------------------
-          elif grep -Eqi \
-            'permission denied|Resource not accessible|403 Forbidden|401 Unauthorized|Invalid token|secrets:|permission check failed' \
-            "$LOG_FILE"; then
-            SHOULD_RERUN="false"
-            USE_DEBUG="true"
-            REASON="permission_auth"
-            REASON_DESC="Permission/Authentication failure — will not rerun"
-
-          # --------------------------
-          # 5. WORKFLOW / SYNTAX (STOP)
-          # --------------------------
-          elif grep -Eqi \
-            'syntax error|YAML parse|mapping values are not allowed|unexpected token|invalid workflow|undefined step|matrix error' \
-            "$LOG_FILE"; then
-            SHOULD_RERUN="false"
-            USE_DEBUG="true"
-            REASON="workflow_syntax"
-            REASON_DESC="Workflow/YAML syntax error — will not rerun"
-
-          # --------------------------
-          # 6. TEST / LINT / CODE (STOP)
-          # --------------------------
-          elif grep -Eqi \
-            'AssertionError|FAILED tests/|test failed|pytest.*failed|jest.*failed|lint failed|eslint error|mypy error|flake8' \
-            "$LOG_FILE"; then
-            SHOULD_RERUN="false"
-            USE_DEBUG="false"
-            REASON="deterministic_test"
-            REASON_DESC="Test/Lint failure — deterministic, no rerun"
-
-          # --------------------------
-          # 7. UNKNOWN (DEBUG RERUN)
-          # --------------------------
-          else
-            SHOULD_RERUN="true"
-            USE_DEBUG="true"
-            REASON="unknown_diagnostic"
-            REASON_DESC="Unclassified failure — rerun with debug logging"
-          fi
-
-          # Export outputs
-          echo "should_rerun=$SHOULD_RERUN" >> "$GITHUB_OUTPUT"
-          echo "use_debug=$USE_DEBUG" >> "$GITHUB_OUTPUT"
-          echo "reason=$REASON" >> "$GITHUB_OUTPUT"
-          echo "reason_desc=$REASON_DESC" >> "$GITHUB_OUTPUT"
-
-      - name: "📤 Upload Diagnostic Artifacts"
-        uses: actions/upload-artifact@v4
-        with:
-          name: "auto-debug-logs-${{ github.event.workflow_run.id }}"
-          path: .diagnostics/
-          retention-days: 14
-          compression-level: 9
-
-  # --------------------------
-  # JOB 2: Rerun Failed Jobs
-  # --------------------------
-  rerun:
-    name: "🔄 Rerun Failed Jobs"
-    needs: diagnose
-    if: needs.diagnose.outputs.should_rerun == 'true'
-    runs-on: ubuntu-latest
-    timeout-minutes: 5
-
-    steps:
-      - name: "🛡️ Check Retry Limit (Max 3)"
-        id: guard
-        env:
-          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
-          RUN_ID: ${{ needs.diagnose.outputs.run_id }}
-          REPO: ${{ github.repository }}
-        run: |
-          ATTEMPT=$(gh run view "$RUN_ID" --repo "$REPO" --json attempt --jq '.attempt')
-          echo "Current attempt: $ATTEMPT"
-
-          if [ "$ATTEMPT" -ge 3 ]; then
-            echo "❌ Max retries reached (3)"
-            echo "allowed=false" >> "$GITHUB_OUTPUT"
-          else
-            echo "✅ Retry allowed"
-            echo "allowed=true" >> "$GITHUB_OUTPUT"
-          fi
-
-      - name: "▶️ Rerun with Appropriate Mode"
-        id: execute
-        if: steps.guard.outputs.allowed == 'true'
-        env:
-          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
-          RUN_ID: ${{ needs.diagnose.outputs.run_id }}
-          REPO: ${{ github.repository }}
-          USE_DEBUG: ${{ needs.diagnose.outputs.use_debug }}
-          REASON: ${{ needs.diagnose.outputs.reason }}
-        run: |
-          echo "=== RERUN START ==="
-          echo "Reason: $REASON"
-          echo "Debug Mode: $USE_DEBUG"
-
-          if [ "$USE_DEBUG" = "true" ]; then
-            echo "Running: gh run rerun --failed --debug"
-            gh run rerun "$RUN_ID" --repo "$REPO" --failed --debug
-          else
-            echo "Running: gh run rerun --failed"
-            gh run rerun "$RUN_ID" --repo "$REPO" --failed
-          fi
-
-      - name: "🛑 Stop — Retry Limit Reached"
-        if: steps.guard.outputs.allowed != 'true'
-        run: |
-          echo "::error title=Auto-Rerun Limit::Max 3 retries exhausted"
-          exit 1
-
-  # --------------------------
-  # JOB 3: Final Report (Always Run)
-  # --------------------------
-  report:
-    name: "📊 Final Report"
-    needs: [diagnose, rerun]
-    if: always()
-    runs-on: ubuntu-latest
-
-    steps:
-      - name: "📝 Generate Diagnostic Report"
-        env:
-          REASON: ${{ needs.diagnose.outputs.reason }}
-          REASON_DESC: ${{ needs.diagnose.outputs.reason }}
-          RUN_ID: ${{ needs.diagnose.outputs.run_id }}
-          SHOULD_RERUN: ${{ needs.diagnose.outputs.should_rerun }}
-          USE_DEBUG: ${{ needs.diagnose.outputs.use_debug }}
-          WORKFLOW_URL: ${{ github.event.workflow_run.html_url }}
-        run: |
-          cat > auto-debug-report.md <<EOF
-# 🛠️ GitHub Auto-Debug & Rerun Report
-
-## 📌 Workflow Context
-- **Workflow:** ${{ github.event.workflow_run.name }}
-- **Run ID:** $RUN_ID
-- **Branch:** ${{ github.event.workflow_run.head_branch }}
