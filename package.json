{
  "name": "fastapi-python-boilerplate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vercel dev",
    "deploy": "vercel --prod",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky install",
    "release": "semantic-release",
    "vite": ">=6.4.3"
  },
  "dependencies": {
    "vercel": "^59.11.7"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.5.0",
    "vitest": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "semantic-release": "^25.0.9",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "vite": ">=8.2.2"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
