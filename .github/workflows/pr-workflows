"""
name: PR Workflow

on:
  pull_request:
    types: [opened, synchronize]

jobs:
  label:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/labeler@v5
        with:
          repo-token: ${{ secrets.GITHUB_TOKEN }}

  reviewer:
    runs-on: ubuntu-latest
    steps:
      - uses: hmarr/auto-assign-action@v2
        with:
          repo-token: ${{ secrets.GITHUB_TOKEN }}
          reviewers: |
            - reviewer1
            - reviewer2