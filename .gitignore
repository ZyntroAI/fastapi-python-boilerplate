# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg-info/
.eggs/
*.egg
*.manifest
*.spec
.env
# Virtual environments
.venv/
env/
venv/
ENV/
env.bak/

# Build & packaging
build/
dist/
wheels/
*.whl

# Testing & coverage
.coverage
coverage.xml
htmlcov/
.tox/
.pytest_cache/
.mypy_cache/
.dmypy.json
.pyre/

# Logs & temp files
*.log
*.tmp
*.swp

# IDE & OS artifacts
.vscode/
.idea/
.DS_Store
Thumbs.db

# Environment & secrets
.env
.env.*
# ...but env TEMPLATES are tracked on purpose — they are documentation, not
# secrets. Without these negations `.env.*` above silently swallows every
# per-component `.env.example` (git check-ignore -v <path> confirms it).
!.env.example
!.env.local.example
!.env.sample
!.env.template
!**/.env.example
*.pem
*.key
*.csv
# Node
node_modules/
coverage/
.vercel/
*.tsbuildinfo

# Deployment & containers
docker-compose.override.yml
*.pid
*.sock

# FastAPI specific
uvicorn.log

# Generated search index (built from knowledge/ notes; see sync_knowledge_index.py)
knowledge_index.json

# Secrets — NEVER commit
**/*secrets*.yaml
**/.env
**/*.key
